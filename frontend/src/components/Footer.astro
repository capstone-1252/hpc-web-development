---
import Logo from "@/assets/logo.png";
import { Image } from "astro:assets"


const currentYear = new Date().getFullYear();
const footerLinks = {
  organization: [
    { href: '/about-us', label: 'About Us' },
    { href: '/services', label: 'Our Services' },
    { href: '/events', label: 'Events' },
    { href: '/contact', label: 'Contact' }
  ],
  resources: [
    { href: '/resources', label: 'Resources' },
    { href: '/faq', label: 'FAQs' },
    { href: '/get-involved', label: 'Get Involved' },
    { href: '/donate', label: 'Donate' }
  ],
};

---

<footer class="bg-gray-900 text-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <div class="grid md:grid-cols-3 gap-20">
      <!-- Organization Info -->
      <div class="col-span-1">
        <div class="flex items-center mb-4">
					<Image src={Logo} alt="Alberta helping animals logo" class="h-12 w-12 mr-3" format="avif" />
          <span class="text-xl font-bold">Alberta Helping Animals Society</span>
        </div>
        <p class="text-gray-300 leading-relaxed text-sm text-gray-400">
					Alberta Helping Animals Society (AHAS) is a non-profit society, incorporated in Alberta and registered as a charity with the Canadian Revenue Agency.
        </p>

      </div>

      <div>
        <h3 class="text-lg font-semibold mb-4">Organization</h3>
        <ul class="space-y-2">
          {footerLinks.organization.map((link) => (
            <li>
              <a 
                href={link.href} 
                class="text-gray-300 hover:text-white transition-colors"
              >
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <div>
        <h3 class="text-lg font-semibold mb-4">Resources</h3>
        <ul class="space-y-2">
          {footerLinks.resources.map((link) => (
            <li>
              <a 
                href={link.href} 
                class="text-gray-300 hover:text-white transition-colors"
              >
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>

    <div class="flex flex-col md:flex-row gap-10 justify-center py-10 max-w-full">
      <p class="text-gray-300 leading-relaxed text-md text-white mb-4">Phone: 587-338-8668</p>
      <p class="text-gray-300 leading-relaxed text-md text-white mb-4">Email: AlbertaHelpingAnimalsSociety@gmail.com</p>
      <p class="text-gray-300 leading-relaxed text-md text-white mb-4">Charitable Number: 840715577RR0001</p>
    </div>

    <!-- Copyright -->
    <div class="mt-8 pt-8 border-t border-gray-800 text-center text-gray-400">
      <p>&copy; {currentYear} Alberta Helping Animals Society. All rights reserved.</p>
    </div>
  </div>
</footer>
