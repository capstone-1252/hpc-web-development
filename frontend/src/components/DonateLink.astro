---
import { Image } from "astro:assets"
import type { ImageMetadata } from "astro"

const { 
	imageSrc, 
	link,
	alt
} = Astro.props

interface Props {
	imageSrc: ImageMetadata
	link: string
	alt: string
}
---

<a href={link} target="_blank" rel="noopener noreferrer"
	class="flex items-center gap-2 border border-gray-200 rounded-xl px-6 py-4 hover:border-[#0C5E6E] hover:shadow-sm transition-all duration-200 bg-white">
	<Image
		src={imageSrc}
		alt={alt}
		class="h-10 w-auto"
	/>
</a>
