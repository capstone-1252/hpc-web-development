---
import Layout from "@/layouts/Layout.astro"
import { Image } from "astro:assets"
import getInvolvedHeroImage from "@/assets/getinvolved-hero.avif"
import vetKarenLeah from "@/assets/vet-karen-leah.avif"
import atbCares from "@/assets/atb-cares.avif"
import canadaHelps from "@/assets/canada-helps.avif"
---

<Layout title="Get Involved - Alberta Helping Animals Society">
	<main class="bg-white"></main>
	<!-- HERO -->
   <section class="bg-[#D1E9EE] py-2 sm:py-2 lg:py-5 px-4 sm:px-2 lg:px-4 overflow-x-hidden">
      <div class="max-w-2xl lg:max-w-7xl mx-auto">
         <div class="flex flex-col lg:flex-row items-center gap-8">
            <!-- Content -->
            <div class="w-full lg:w-1/2">
               <h1 class="text-2xl sm:text-3xl lg:text-4xl font-bold text-(--dark-blue) mb-4 lg:mb-6 leading-tight break-words">
                  Get Involved with AHAS
               </h1>
               <p class="text-lg sm:text-xl text-[var(--muted-foreground)] mb-6 lg:mb-8 leading-relaxed max-w-2xl lg:mx-0">Make a meaningful difference in the lives of animals in our community. Every contribution — big or small — creates lasting impact.
               </p>
            </div>
			<!-- Banner Image -->
            <div class="w-full lg:w-1/2 flex justify-center lg:justify-end">
               <Image 
                  src={getInvolvedHeroImage} 
                  alt="Hero Banner for Get Involved Page"
                  class="w-[420px] sm:w-[400px] md:w-[350px] lg:w-[500px] max-w-none"
                  />
            </div>
         </div>
      </div>
   </section>

  <!-- DONATE SECTION -->
  <section id="donate" class="py-16 lg:py-20 px-4 sm:px-6 lg:px-8 bg-white">
    <div class="max-w-6xl mx-auto">

      <!-- Section Header -->
      <div class="max-w-2xl mb-12">
        <h2 class="text-3xl lg:text-3xl font-bold text-[#2b4a5a] mb-4">Donate & Make a Difference</h2>
        <p class="lg:text-lg text-[var(--card-foreground)] leading-relaxed">
          Your generosity helps provide food, medical care, shelter, and second chances for animals in need. Every contribution — big or small — directly supports the animals we care for.
        </p>
      </div>

      <!-- Partner Logos -->
      <div class="flex flex-wrap items-center gap-6 mb-14">
        <a href="https://atb.benevity.org/community/cause/124-840715577RR0001" target="_blank" rel="noopener noreferrer"
           class="flex items-center gap-2 border border-gray-200 rounded-xl px-6 py-4 hover:border-[#0C5E6E] hover:shadow-sm transition-all duration-200 bg-white">
         <Image
              src={atbCares}
              alt="ATB Cares"
              class="h-10 w-auto"
            />
        </a>
        <a href="https://canadahelps.org" target="_blank" rel="noopener noreferrer"
           class="flex items-center gap-2 border border-gray-200 rounded-xl px-6 py-4 hover:border-[#0C5E6E] hover:shadow-sm transition-all duration-200 bg-white">
           <Image
              src={canadaHelps}
              alt="Donate through CanadaHelps.org"
              class="h-10 w-auto"
            />
        </a>
      </div>

      <!-- Monetary Donations Card -->
      <div class="bg-[#D1E9EE] rounded-2xl p-8 lg:p-10 mb-8 border border-[#c2dfe9]">
        <h2 class="text-3xl font-bold text-[#0C5E6E] mb-3">Monetary Donations</h2>
        <p class="text-[#4a6070] text-lg mb-5">Make a one-time gift or set up monthly giving to create lasting impact.</p>
        <ul class="space-y-2 mb-7">
          <li class="flex items-start gap-3 text-[#4a6070]">
            <span class="mt-1 flex-shrink-0 w-5 h-5 rounded-full bg-[#0C5E6E] flex items-center justify-center">
              <svg class="w-3 h-3 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3">
                <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
              </svg>
            </span>
            Eligible for a charitable tax receipt (ATB Cares)
          </li>
          <li class="flex items-start gap-3 text-[#4a6070]">
            <span class="mt-1 flex-shrink-0 w-5 h-5 rounded-full bg-[#0C5E6E] flex items-center justify-center">
              <svg class="w-3 h-3 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3">
                <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
              </svg>
            </span>
            Donations of $10 or more qualify for a tax receipt
          </li>
          <li class="flex items-start gap-3 text-[#4a6070]">
            <span class="mt-1 flex-shrink-0 w-5 h-5 rounded-full bg-[#0C5E6E] flex items-center justify-center">
              <svg class="w-3 h-3 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3">
                <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
              </svg>
            </span>
            You can set up monthly donations or a fundraiser via Canada Helps
          </li>
        </ul>
        <a href="https://www.canadahelps.org/en/dn/60255" target="_blank" rel="noopener noreferrer"
           class="inline-flex items-center gap-2 bg-[#0C5E6E] text-white font-semibold px-6 py-3 rounded-lg hover:shadow-xl hover:-translate-y-0.5 transition-colors duration-200 shadow-sm">
          Donate via Canada Helps
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" />
          </svg>
        </a>
      </div>
    </div>
  </section>

  <!-- VOLUNTEER SECTION -->
  <section id="volunteer" class="py-16 lg:py-20 px-4 sm:px-6 lg:px-8 bg-[#f7fafb]">
    <div class="max-w-6xl mx-auto">

      <div class="flex flex-col lg:flex-row gap-12 lg:gap-16 items-start">

        <!-- Left: text content -->
        <div class="w-full lg:w-1/2">
          <h2 class="text-3xl lg:text-4xl font-bold text-[#0C5E6E] mb-5">Volunteer With Us</h2>
          <p class="text-[var(--card-foreground)] text-lg leading-relaxed mb-8">
            Our volunteers are the heart of Alberta Helping Animals Society. Your time, skills, and passion help us rescue, care for, and advocate for animals in need. Whether you can give a few hours or take on an ongoing role, your support truly matters.
          </p>

          <h3 class="text-lg font-bold text-[#0C5E6E] mb-4">We're currently looking for help in:</h3>
          <ul class="grid grid-cols-1 sm:grid-cols-2 gap-3 mb-8">
            {[
              "Veterinary Assistance",
              "Fundraising Support",
              "Event Ideas, Planning & Coordination",
              "Driving & Transportation",
              "Educational Seminars (Planning or Speaking)",
              "Administrative Support",
              "Brochure & Graphic Design",
            ].map((role) => (
              <li class="flex items-center gap-3 bg-white border border-gray-200 rounded-lg px-4 py-3 text-sm text-[#2b4a5a] font-medium shadow-sm hover:border-[#3a7ca5] hover:shadow transition-all duration-200">
                {role}
              </li>
            ))}
          </ul>

          <a href="/volunteer-with-us"
             class="inline-flex items-center gap-2 bg-[#0C5E6E] text-white font-semibold px-6 py-3 rounded-lg hover:shadow-xl hover:-translate-y-0.5 transition-colors duration-200 shadow-sm">
            Learn More
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" />
            </svg>
          </a>
        </div>

        <!-- Right: image -->
        <div class="w-full lg:w-1/2">
          <div class="relative">
            <Image
              src={vetKarenLeah}
              alt="AHAS volunteers Karen and Leah working together"
              class="w-full rounded-2xl shadow-xl object-cover aspect-[4/3]"
            />
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- FUNDRAISING EVENTS SECTION -->
  <section id="events" class="py-16 lg:py-20 px-4 sm:px-6 lg:px-8 bg-white">
    <div class="max-w-6xl mx-auto">
      <div class="bg-gradient-to-br from-[#2b4a5a] to-[#3a7ca5] rounded-2xl overflow-hidden shadow-xl">
        <div class="flex flex-col lg:flex-row">

          <!-- Content -->
          <div class="p-10 lg:p-14 w-full lg:w-3/5">
            <h2 class="text-3xl lg:text-4xl font-bold text-white mb-5">Fundraising Events</h2>
            <p class="text-[#cce8f4] leading-relaxed mb-4">
              Join us at our upcoming events and help make a real difference for animals in need. From community fundraisers to awareness initiatives, every event supports our mission and brings people together for a great cause.
            </p>
            <p class="text-[#cce8f4] leading-relaxed mb-8">
              Whether you attend, sponsor, volunteer, or help spread the word, your involvement helps provide food, medical care, and safe shelter for animals in our community.
            </p>
            <a href="/events"
               class="inline-flex items-center gap-2 bg-white text-[var(--dark-blue)] font-semibold px-6 py-3 rounded-lg hover:shadow-xl hover:-translate-y-0.5 transition-colors duration-200 shadow-sm">
              View our full event calendar
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" />
              </svg>
            </a>
          </div>


          <div class="hidden lg:flex w-2/5 bg-[#3a7ca5]/30 items-center justify-center p-10">
            <div class="text-center">
              <div class="text-7xl mb-4">🐾</div>
            </div>
          </div>

        </div>
      </div>
    </div>
  </section>


</Layout>
