---
import Layout from "@/layouts/Layout.astro"
---

<Layout title="Get Involved - Alberta Helping Animals Society">
	<main class="bg-white">
		<!-- Hero Section -->
		<section class="relative bg-gradient-to-br from-[#e8f4f7] to-[#d1e9ee] py-12 sm:py-16 lg:py-20 px-4 sm:px-6 lg:px-8">
			<div class="max-w-7xl mx-auto text-center">
				<h1 class="text-3xl sm:text-4xl lg:text-5xl font-bold text-[#485a61] mb-6 lg:mb-8">Get Involved</h1>
				<p class="text-lg sm:text-xl lg:text-2xl text-[#485a61] opacity-80 max-w-4xl mx-auto leading-relaxed">
					Join our community of compassionate individuals working together to make a difference in the lives of Alberta's animals and their families.
				</p>
			</div>
		</section>

		<!-- Ways to Help Section -->
		<section class="py-12 sm:py-16 px-4 sm:px-6 lg:px-8">
			<div class="max-w-6xl mx-auto">
				<div class="text-center mb-8 lg:mb-12">
					<h2 class="text-2xl sm:text-3xl lg:text-4xl font-bold text-[#485a61] mb-4 lg:mb-6">Ways to Help</h2>
					<p class="text-lg lg:text-xl text-[#485a61] opacity-80 max-w-4xl mx-auto leading-relaxed">
						Whether you have time to volunteer, resources to donate, or skills to share, there are many ways you can support our mission.
					</p>
				</div>

				<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 lg:gap-8">
					<!-- Volunteer -->
					<div class="bg-white p-6 lg:p-8 rounded-lg shadow-lg border border-gray-200 hover:shadow-xl transition-shadow">
						<div class="w-16 h-16 bg-[#e25002] bg-opacity-10 rounded-lg flex items-center justify-center mb-4 lg:mb-6">
							<svg class="w-8 h-8 text-[#e25002]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" />
							</svg>
						</div>
						<h3 class="text-xl lg:text-2xl font-bold text-[#485a61] mb-4">Volunteer</h3>
						<p class="text-[#485a61] opacity-80 leading-relaxed mb-4">
							Join our dedicated team of volunteers and help provide care and support to animals in need. From clinic assistance to community outreach, there's a role for everyone.
						</p>
						<ul class="text-[#485a61] opacity-80 text-sm space-y-2 mb-4">
							<li>• Clinic assistance</li>
							<li>• Administrative support</li>
							<li>• Event coordination</li>
							<li>• Community outreach</li>
						</ul>
						<button class="bg-[#e25002] hover:bg-[#c44301] text-white px-4 lg:px-6 py-2 lg:py-3 rounded-lg text-sm lg:text-base font-semibold transition-colors w-full">
							Learn More
						</button>
					</div>

					<!-- Donate -->
					<div class="bg-white p-6 lg:p-8 rounded-lg shadow-lg border border-gray-200 hover:shadow-xl transition-shadow">
						<div class="w-16 h-16 bg-[#19b8d7] bg-opacity-10 rounded-lg flex items-center justify-center mb-4 lg:mb-6">
							<svg class="w-8 h-8 text-[#19b8d7]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z" />
							</svg>
						</div>
						<h3 class="text-xl lg:text-2xl font-bold text-[#485a61] mb-4">Donate</h3>
						<p class="text-[#485a61] opacity-80 leading-relaxed mb-4">
							Your financial support helps us provide essential veterinary care, medical supplies, and services to animals and families who need it most.
						</p>
						<ul class="text-[#485a61] opacity-80 text-sm space-y-2 mb-4">
							<li>• One-time donations</li>
							<li>• Monthly giving programs</li>
							<li>• Memorial donations</li>
							<li>• Corporate sponsorships</li>
						</ul>
						<button class="bg-[#19b8d7] hover:bg-[#1596af] text-white px-4 lg:px-6 py-2 lg:py-3 rounded-lg text-sm lg:text-base font-semibold transition-colors w-full">
							Donate Now
						</button>
					</div>

					<!-- Foster -->
					<div class="bg-white p-6 lg:p-8 rounded-lg shadow-lg border border-gray-200 hover:shadow-xl transition-shadow">
						<div class="w-16 h-16 bg-[#fdb52b] bg-opacity-20 rounded-lg flex items-center justify-center mb-4 lg:mb-6">
							<svg class="w-8 h-8 text-[#fdb52b]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" />
							</svg>
						</div>
						<h3 class="text-xl lg:text-2xl font-bold text-[#485a61] mb-4">Foster Care</h3>
						<p class="text-[#485a61] opacity-80 leading-relaxed mb-4">
							Provide a temporary loving home for animals recovering from medical treatment or waiting for their forever homes. Fostering saves lives.
						</p>
						<ul class="text-[#485a61] opacity-80 text-sm space-y-2 mb-4">
							<li>• Short-term fostering</li>
							<li>• Medical foster homes</li>
							<li>• Support and training provided</li>
							<li>• Supplies covered by AHAS</li>
						</ul>
						<button class="bg-[#fdb52b] hover:bg-[#e6a426] text-white px-4 lg:px-6 py-2 lg:py-3 rounded-lg text-sm lg:text-base font-semibold transition-colors w-full">
							Become a Foster
						</button>
					</div>
				</div>
			</div>
		</section>

		<!-- Volunteer Opportunities Section -->
		<section class="py-12 sm:py-16 px-4 sm:px-6 lg:px-8 bg-gray-50">
			<div class="max-w-6xl mx-auto">
				<div class="text-center mb-8 lg:mb-12">
					<h2 class="text-2xl sm:text-3xl lg:text-4xl font-bold text-[#485a61] mb-4 lg:mb-6">Current Volunteer Opportunities</h2>
					<p class="text-lg lg:text-xl text-[#485a61] opacity-80 max-w-4xl mx-auto leading-relaxed">
						We have various volunteer positions available. All training is provided, and no experience is necessary for most roles.
					</p>
				</div>

				<VolunteerOpportunitiesList client:load />
			</div>
		</section>

		<!-- Donation Section -->
		<section class="py-12 sm:py-16 px-4 sm:px-6 lg:px-8">
			<div class="max-w-6xl mx-auto">
				<div class="text-center mb-8 lg:mb-12">
					<h2 class="text-2xl sm:text-3xl lg:text-4xl font-bold text-[#485a61] mb-4 lg:mb-6">Make a Difference Today</h2>
					<p class="text-lg lg:text-xl text-[#485a61] opacity-80 max-w-4xl mx-auto leading-relaxed">
						Your donation directly impacts the lives of animals and their families. Every contribution, no matter the size, makes a meaningful difference.
					</p>
				</div>

				<div class="grid grid-cols-1 md:grid-cols-3 gap-6 lg:gap-8">
					<div class="text-center">
						<div class="w-20 h-20 bg-[#e25002] bg-opacity-10 rounded-full flex items-center justify-center mx-auto mb-4">
							<span class="text-2xl font-bold text-[#e25002]">$25</span>
						</div>
						<h3 class="text-lg font-bold text-[#485a61] mb-2">Basic Care Package</h3>
						<p class="text-[#485a61] opacity-80 text-sm">Provides vaccinations and parasite treatment for one pet</p>
					</div>

					<div class="text-center">
						<div class="w-20 h-20 bg-[#19b8d7] bg-opacity-10 rounded-full flex items-center justify-center mx-auto mb-4">
							<span class="text-2xl font-bold text-[#19b8d7]">$50</span>
						</div>
						<h3 class="text-lg font-bold text-[#485a61] mb-2">Wellness Exam</h3>
						<p class="text-[#485a61] opacity-80 text-sm">Covers a complete health checkup for one animal</p>
					</div>

					<div class="text-center">
						<div class="w-20 h-20 bg-[#fdb52b] bg-opacity-20 rounded-full flex items-center justify-center mx-auto mb-4">
							<span class="text-2xl font-bold text-[#fdb52b]">$100</span>
						</div>
						<h3 class="text-lg font-bold text-[#485a61] mb-2">Emergency Care</h3>
						<p class="text-[#485a61] opacity-80 text-sm">Helps provide emergency medical treatment for animals in crisis</p>
					</div>
				</div>

				<div class="text-center mt-8 lg:mt-12">
					<button class="bg-[#e25002] hover:bg-[#c44301] text-white px-8 lg:px-10 py-3 lg:py-4 rounded-lg text-base lg:text-lg font-semibold transition-colors shadow-lg hover:shadow-xl transform hover:scale-105">
						Donate Now
					</button>
				</div>
			</div>
		</section>

		<!-- Corporate Partnership Section -->
		<section class="py-12 sm:py-16 px-4 sm:px-6 lg:px-8 bg-gray-50">
			<div class="max-w-6xl mx-auto">
				<div class="bg-white p-6 lg:p-8 rounded-lg shadow-lg border border-gray-200">
					<div class="text-center mb-8 lg:mb-12">
						<h2 class="text-2xl sm:text-3xl lg:text-4xl font-bold text-[#485a61] mb-4 lg:mb-6">Corporate Partnerships</h2>
						<p class="text-lg lg:text-xl text-[#485a61] opacity-80 max-w-4xl mx-auto leading-relaxed">
							Partner with us to make a lasting impact on animal welfare in our community. We offer various sponsorship opportunities for businesses of all sizes.
						</p>
					</div>

					<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
						<div class="text-center">
							<div class="w-16 h-16 bg-[#19b8d7] bg-opacity-10 rounded-lg flex items-center justify-center mx-auto mb-4">
								<svg class="w-8 h-8 text-[#19b8d7]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" />
								</svg>
							</div>
							<h3 class="text-lg font-bold text-[#485a61] mb-2">Event Sponsorship</h3>
							<p class="text-[#485a61] opacity-80 text-sm">Support our fundraising events and community programs</p>
						</div>

						<div class="text-center">
							<div class="w-16 h-16 bg-[#fdb52b] bg-opacity-20 rounded-lg flex items-center justify-center mx-auto mb-4">
								<svg class="w-8 h-8 text-[#fdb52b]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
								</svg>
							</div>
							<h3 class="text-lg font-bold text-[#485a61] mb-2">Educational Programs</h3>
							<p class="text-[#485a61] opacity-80 text-sm">Support community education and outreach initiatives</p>
						</div>

						<div class="text-center">
							<div class="w-16 h-16 bg-[#e25002] bg-opacity-10 rounded-lg flex items-center justify-center mx-auto mb-4">
								<svg class="w-8 h-8 text-[#e25002]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z" />
								</svg>
							</div>
							<h3 class="text-lg font-bold text-[#485a61] mb-2">Employee Giving</h3>
							<p class="text-[#485a61] opacity-80 text-sm">Create employee engagement and matching gift programs</p>
						</div>

						<div class="text-center">
							<div class="w-16 h-16 bg-[#485a61] bg-opacity-10 rounded-lg flex items-center justify-center mx-auto mb-4">
								<svg class="w-8 h-8 text-[#485a61]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
								</svg>
							</div>
							<h3 class="text-lg font-bold text-[#485a61] mb-2">In-Kind Donations</h3>
							<p class="text-[#485a61] opacity-80 text-sm">Provide supplies, services, or expertise</p>
						</div>
					</div>

					<div class="text-center mt-8 lg:mt-12">
						<button class="bg-[#485a61] hover:bg-[#3a484f] text-white px-8 lg:px-10 py-3 lg:py-4 rounded-lg text-base lg:text-lg font-semibold transition-colors">
							Learn About Partnerships
						</button>
					</div>
				</div>
			</div>
		</section>

		<!-- CTA Section -->
		<section class="py-12 sm:py-16 px-4 sm:px-6 lg:px-8 bg-gradient-to-br from-[#19b8d7] to-[#485a61]">
			<div class="max-w-4xl mx-auto text-center">
				<h2 class="text-2xl sm:text-3xl lg:text-4xl font-bold text-white mb-4 lg:mb-6">
					Ready to Make a Difference?
				</h2>
				<p class="text-lg sm:text-xl text-white opacity-90 mb-6 lg:mb-8 leading-relaxed max-w-3xl mx-auto">
					Whether you choose to volunteer, donate, or spread awareness, your support helps us continue our mission 
					to provide compassionate care for Alberta's animals and their families.
				</p>
				<div class="flex flex-col sm:flex-row gap-3 lg:gap-4 justify-center">
					<button class="bg-white hover:bg-gray-100 text-[#19b8d7] px-6 lg:px-8 py-3 lg:py-4 rounded-lg text-base lg:text-lg font-semibold transition-colors shadow-lg hover:shadow-xl transform hover:scale-105 whitespace-nowrap">
						Become a Volunteer
					</button>
					<button class="border-2 border-white text-white hover:bg-white hover:text-[#485a61] px-6 lg:px-8 py-3 lg:py-4 rounded-lg text-base lg:text-lg font-semibold transition-colors whitespace-nowrap">
						Make a Donation
					</button>
				</div>
			</div>
		</section>
	</main>
</Layout>