---
import Layout from "@/layouts/Layout.astro"
import { Image } from "astro:assets"
import getInvolvedHeroImage from "@/assets/getinvolved-hero.avif"
---

<Layout title="Get Involved - Alberta Helping Animals Society">
	<main class="bg-white"></main>
	<!-- HERO -->
   <section class="bg-[#D1E9EE] py-2 sm:py-2 lg:py-5 px-4 sm:px-2 lg:px-4 overflow-x-hidden">
      <div class="max-w-2xl lg:max-w-7xl mx-auto">
         <div class="flex flex-col lg:flex-row items-center gap-8">
            <!-- Content -->
            <div class="w-full lg:w-1/2">
               <h1 class="text-2xl sm:text-3xl lg:text-4xl font-bold text-(--dark-blue) mb-4 lg:mb-6 leading-tight break-words">
                  Get Involved with AHAS
               </h1>
               <p class="text-lg sm:text-xl text-[var(--muted-foreground)] mb-6 lg:mb-8 leading-relaxed max-w-2xl lg:mx-0">Make a meaningful difference in the lives of animals in our community. Every contribution — big or small — creates lasting impact.
               </p>
            </div>
			<!-- Banner Image -->
            <div class="w-full lg:w-1/2 flex justify-center lg:justify-end">
               <Image 
                  src={getInvolvedHeroImage} 
                  alt="Hero Banner for Get Involved Page"
                  class="w-[420px] sm:w-[400px] md:w-[350px] lg:w-[500px] max-w-none"
                  />
            </div>
         </div>
      </div>
   </section>

      <section class="py-12 sm:py-16 px-4 sm:px-6 lg:px-8 max-w-6xl mx-auto">
         <div class="mb-8 lg:mb-12">
            <h2 class="text-3xl sm:text-2xl lg:text-3xl font-bold text-[#485a61] mb-4 lg:mb-6">Donate & Make a Difference</h2>
            <p class="max-w-3xl text-base lg:text-lg text-[#2B2F3BCC] opacity-80  leading-relaxed">
               Your generosity helps provide food, medical care, shelter, and second chances for animals in need. Every contribution — big or small — directly supports the animals we care for.
            </p>
         </div>
      </section>

</Layout>
