---
import Layout from "@/layouts/Layout.astro"
import { FAQList } from "@/components/FAQ/FAQList"
---

<Layout title="Frequently Asked Questions - Alberta Helping Animals Society">
	<main class="bg-white">
		<!-- Hero Section -->
		<section class="relative bg-gradient-to-br from-[#e8f4f7] to-[#d1e9ee] py-12 sm:py-16 lg:py-20 px-4 sm:px-6 lg:px-8">
			<div class="max-w-7xl mx-auto text-center">
				<h1 class="text-3xl sm:text-4xl lg:text-5xl font-bold text-[#485a61] mb-6 lg:mb-8">Frequently Asked Questions</h1>
				<p class="text-lg sm:text-xl lg:text-2xl text-[#485a61] opacity-80 max-w-4xl mx-auto leading-relaxed">
					Find answers to common questions about our services, programs, and how we help Alberta's animals and their families.
				</p>
			</div>
		</section>

		<!-- FAQ Section -->
		<section class="py-12 sm:py-16 px-4 sm:px-6 lg:px-8">
			<div class="max-w-4xl mx-auto">
				<div class="bg-white rounded-lg shadow-lg border border-gray-200">
					<FAQList client:load />
				</div>
			</div>
		</section>

		<!-- Additional Help Section -->
		<section class="py-12 sm:py-16 px-4 sm:px-6 lg:px-8 bg-gray-50">
			<div class="max-w-6xl mx-auto">
				<div class="text-center mb-8 lg:mb-12">
					<h2 class="text-2xl sm:text-3xl lg:text-4xl font-bold text-[#485a61] mb-4 lg:mb-6">Still Have Questions?</h2>
					<p class="text-lg lg:text-xl text-[#485a61] opacity-80 max-w-4xl mx-auto leading-relaxed">
						If you couldn't find the answer you're looking for, we're here to help. Contact our team for personalized assistance.
					</p>
				</div>

				<div class="grid grid-cols-1 md:grid-cols-2 gap-6 lg:gap-8">
					<div class="bg-white p-6 lg:p-8 rounded-lg shadow-lg border border-gray-200">
						<div class="w-12 h-12 lg:w-16 lg:h-16 bg-[#19b8d7] bg-opacity-10 rounded-lg flex items-center justify-center mb-4 lg:mb-6">
							<svg class="w-6 h-6 lg:w-8 lg:h-8 text-[#19b8d7]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
							</svg>
						</div>
						<h3 class="text-xl lg:text-2xl font-bold text-[#485a61] mb-4">Call Us</h3>
						<p class="text-lg text-[#485a61] opacity-80 leading-relaxed mb-4">
							Speak directly with our team for immediate assistance with your questions.
						</p>
						<p class="text-lg font-semibold text-[#19b8d7]">587-338-8668</p>
						<p class="text-sm text-[#485a61] opacity-80 mt-2">Please leave a detailed message and we'll return your call as soon as possible.</p>
					</div>

					<div class="bg-white p-6 lg:p-8 rounded-lg shadow-lg border border-gray-200">
						<div class="w-12 h-12 lg:w-16 lg:h-16 bg-[#e25002] bg-opacity-10 rounded-lg flex items-center justify-center mb-4 lg:mb-6">
							<svg class="w-6 h-6 lg:w-8 lg:h-8 text-[#e25002]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 4.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
							</svg>
						</div>
						<h3 class="text-xl lg:text-2xl font-bold text-[#485a61] mb-4">Email Us</h3>
						<p class="text-lg text-[#485a61] opacity-80 leading-relaxed mb-4">
							Send us your questions and we'll respond with detailed information to help you.
						</p>
						<p class="text-lg font-semibold text-[#e25002]">AlbertaHelpingAnimalsSociety@gmail.com</p>
						<p class="text-sm text-[#485a61] opacity-80 mt-2">We typically respond within 3-5 business days.</p>
					</div>
				</div>
			</div>
		</section>

		<!-- Contact CTA Section -->
		<section class="py-12 sm:py-16 px-4 sm:px-6 lg:px-8 bg-gradient-to-br from-[#19b8d7] to-[#485a61]">
			<div class="max-w-4xl mx-auto text-center">
				<h2 class="text-2xl sm:text-3xl lg:text-4xl font-bold text-white mb-4 lg:mb-6">
					Ready to Get Help?
				</h2>
				<p class="text-lg sm:text-xl text-white opacity-90 mb-6 lg:mb-8 leading-relaxed max-w-3xl mx-auto">
					If you need veterinary services, food assistance, or other support for your pets, 
					reach out to us today. We're here to help you and your furry family members.
				</p>
				<div class="flex flex-col sm:flex-row gap-3 lg:gap-4 justify-center">
					<a 
						href="/services/apply" 
						class="bg-white hover:bg-gray-100 text-[#19b8d7] px-6 lg:px-8 py-3 lg:py-4 rounded-lg text-base lg:text-lg font-semibold transition-colors shadow-lg hover:shadow-xl transform hover:scale-105 whitespace-nowrap"
					>
						Apply for Services
					</a>
					<a 
						href="/contact" 
						class="border-2 border-white text-white hover:bg-white hover:text-[#485a61] px-6 lg:px-8 py-3 lg:py-4 rounded-lg text-base lg:text-lg font-semibold transition-colors whitespace-nowrap"
					>
						Contact Us
					</a>
				</div>
			</div>
		</section>
	</main>
</Layout>

