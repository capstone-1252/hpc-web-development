---
import Layout from "@/layouts/Layout.astro"
import { Image } from "astro:assets"
import { AlertTriangle, XCircle, ExternalLink } from "@lucide/astro"
import applyForServicesHeroImage from "@/assets/applyforservices-hero.avif"
---
<Layout title="Apply for Services - Alberta Helping Animals Society">
   <main class="bg-white">
      <!-- Hero Section -->
      <section class="relative bg-(--primary) py-2 sm:py-2 lg:py-5 px-4 sm:px-2 lg:px-4 overflow-x-hidden">
         <div class="max-w-7xl mx-auto">
            <div class="flex flex-col lg:flex-row items-center justify-between gap-10">
               <div class="max-w-2xl">
                  <h1 class="text-4xl font-bold text-[#485a61] mb-6 lg:mb-8">
                     Apply for Services
                  </h1>
                  <p class="text-lg text-[#485a61] opacity-80 leading-relaxed mb-8">
                     Complete our application form to access no-cost veterinary services for qualifying low-income pet owners in Edmonton.
                  </p>
               </div>
               <!-- Banner Image -->
               <div class="flex justify-center lg:justify-end w-full lg:w-1/2">
                  <Image 
                     src={applyForServicesHeroImage} 
                     alt="Hero Banner for Apply for Services Page"
                     class="w-[320px] sm:w-[380px] md:w-[420px] lg:w-[500px] h-auto"
                     />
               </div>
            </div>
         </div>
      </section>
      <!-- Application Information Section -->
      <section class="py-12 sm:py-16 px-4 sm:px-6 lg:px-8">
         <div class="max-w-4xl mx-auto">
            <div class="bg-white p-6 lg:p-8 rounded-md shadow-lg border border-gray-200">
               <!-- Important Notices -->
               <div class="space-y-4 mb-8">
                  <div class="bg-yellow-50 border-l-4 border-yellow-400 p-4">
                     <div class="flex">
                        <div class="flex-shrink-0">
                           <AlertTriangle class="h-5 w-5 text-yellow-400" />
                        </div>
                        <div class="ml-3">
                           <p class="text-sm text-yellow-700">
                              <strong>Please Note:</strong> It may take a few days to get back to you. You will receive an email asking to send in qualifying information. Please do not call or email us to check on your application status as it slows down our volunteers.
                           </p>
                        </div>
                     </div>
                  </div>
                  <div class="bg-red-50 border-l-4 border-red-400 p-4">
                     <div class="flex">
                        <div class="flex-shrink-0">
                           <XCircle class="h-5 w-5 text-red-400" />
                        </div>
                        <div class="ml-3">
                           <p class="text-sm text-red-700">
                              <strong>Emergency Services:</strong> We are not able to offer urgent services to new clients except under extraordinary circumstances. If you have an urgent need, please contact an emergency clinic near you.
                           </p>
                        </div>
                     </div>
                  </div>
               </div>
               <!-- Google Form Link Section -->
               <div class="bg-gray-50 border border-gray-200 rounded-md p-6 mb-8">
                  <h2 class="text-xl font-bold text-[#485a61] mb-4">How to Apply</h2>
                  <p class="text-[#485a61] opacity-80 mb-4">
                     Please click the button below to access our application form. You will be redirected to a Google Form where you can complete and submit your application.
                  </p>
                  <p class="text-[#485a61] opacity-80 mb-6">
                     <strong>Important:</strong> AHAS Home Veterinary Services provides basic veterinary care to people living with a very low income in Edmonton. Our policy is to ensure all patients are spayed/neutered as long as they are healthy; we will not see your pets if you will not spay/neuter them.
                  </p>
                  <p class="text-[#485a61] opacity-80 mb-6">
                     If you need spay/neuter services for a young, healthy dog, please apply to the PALS program at the Edmonton Humane Society: <a href="https://www.edmontonhumanesociety.com/services/pals-spay-and-neuter-program/" target="_blank" rel="noopener noreferrer" class="text-[#19b8d7] hover:underline">https://www.edmontonhumanesociety.com/services/pals-spay-and-neuter-program/</a>
                  </p>
                  <div class="flex flex-col sm:flex-row items-center gap-4">
                     <a 
                        href="https://docs.google.com/forms/d/e/1FAIpQLSeVSiWKxkxSF6AGuuAH1a76CgDdWwl-JAMCLap3Mw8_24Y3VQ/viewform" 
                        target="_blank" 
                        rel="noopener noreferrer"
                        class="bg-[#e25002] hover:bg-[#c44301] text-white px-8 py-4 rounded-md text-lg font-semibold transition-colors shadow-lg hover:shadow-xl flex items-center gap-3 whitespace-nowrap"
                     >
                        <ExternalLink class="w-5 h-5" />
                        Open Google Form Application
                     </a>
                     <span class="text-sm text-[#485a61] opacity-70">
                        (Opens in a new tab)
                     </span>
                  </div>
               </div>
               <!-- Eligibility Information -->
               <div class="border-t border-gray-200 pt-8">
                  <h2 class="text-xl font-bold text-[#485a61] mb-4">Eligibility Requirements</h2>
                  <div class="space-y-4">
                     <div>
                        <h3 class="text-lg font-semibold text-[#485a61] mb-2">Income Guidelines by Household Size (2025)</h3>
                        <ul class="list-disc list-inside text-[#485a61] opacity-80 space-y-1">
                           <li>1 person: $30,523 or less</li>
                           <li>2 people: $38,002 or less</li>
                           <li>3 people: $46,720 or less</li>
                           <li>4 people: $56,724 or less</li>
                        </ul>
                     </div>
                </div>
            </div>
         </div>
      </section>
      <!-- What Happens Next Section -->
      <section class="py-12 sm:py-16 px-4 sm:px-6 lg:px-8 bg-gray-50">
         <div class="max-w-6xl mx-auto">
            <div class="text-center mb-8 lg:mb-12">
               <h2 class="text-2xl sm:text-3xl lg:text-4xl font-bold text-[#485a61] mb-4 lg:mb-6">What Happens Next?</h2>
               <p class="text-lg lg:text-xl text-[#485a61] opacity-80 max-w-4xl mx-auto leading-relaxed">
                  Understanding our application process and what to expect after you submit your application.
               </p>
            </div>
            <div class="grid grid-cols-1 md:grid-cols-3 gap-6 max-w-4xl mx-auto">
               <div class="text-center">
                  <div class="w-16 h-16 bg-[#19b8d7] bg-opacity-10 rounded-full flex items-center justify-center mx-auto mb-4">
                     <span class="text-2xl font-bold text-white">1</span>
                  </div>
                  <h3 class="text-lg font-bold text-[#485a61] mb-2">Submit Application</h3>
                  <p class="text-[#485a61] opacity-80 text-sm">Complete and submit the online application form with all required information.</p>
               </div>
               <div class="text-center">
                  <div class="w-16 h-16 bg-[#fdb52b] bg-opacity-20 rounded-full flex items-center justify-center mx-auto mb-4">
                     <span class="text-2xl font-bold text-white">2</span>
                  </div>
                  <h3 class="text-lg font-bold text-[#485a61] mb-2">Application Review</h3>
                  <p class="text-[#485a61] opacity-80 text-sm">Our team reviews your application and documents. This may take several days.</p>
               </div>
               <div class="text-center">
                  <div class="w-16 h-16 bg-[#485a61] bg-opacity-10 rounded-full flex items-center justify-center mx-auto mb-4">
                     <span class="text-2xl font-bold text-white">3</span>
                  </div>
                  <h3 class="text-lg font-bold text-[#485a61] mb-2">Appointment Booking</h3>
                  <p class="text-[#485a61] opacity-80 text-sm">If approved, you'll be contacted to schedule your pet's veterinary appointment.</p>
               </div>
            </div>
         </div>
      </section>
   </main>
</Layout>