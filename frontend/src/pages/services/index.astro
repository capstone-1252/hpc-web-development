---
import Layout from "@/layouts/Layout.astro"
import { ServicesList } from "@/components/Services/ServicesList"
import { FoodBanksList } from "@/components/FoodBanks/FoodBanksList"
---

<Layout title="Our Services - Alberta Helping Animals Society">
	<main class="bg-white">
		<!-- Hero Section -->
		<section class="relative bg-gradient-to-br from-[#e8f4f7] to-[#d1e9ee] py-12 sm:py-16 lg:py-20 px-4 sm:px-6 lg:px-8">
			<div class="max-w-7xl mx-auto text-center">
				<h1 class="text-3xl sm:text-4xl lg:text-5xl font-bold text-[#485a61] mb-6 lg:mb-8">Our Services</h1>
				<p class="text-lg sm:text-xl lg:text-2xl text-[#485a61] opacity-80 max-w-4xl mx-auto leading-relaxed mb-8">
					AHAS provides no-cost veterinary services in Edmonton to qualified clients who are unable to access regular veterinary care.
				</p>
				<a 
					href="/services/apply" 
					class="inline-block bg-[#e25002] hover:bg-[#c44301] text-white px-8 lg:px-10 py-3 lg:py-4 rounded-lg text-base lg:text-lg font-semibold transition-colors shadow-lg hover:shadow-xl transform hover:scale-105"
				>
					Apply for Services
				</a>
			</div>
		</section>

		<!-- Services Overview -->
		<section class="py-12 sm:py-16 px-4 sm:px-6 lg:px-8 max-w-6xl mx-auto">
			<div class="mb-8 lg:mb-12">
				<h2 class="text-2xl sm:text-3xl lg:text-4xl font-bold text-[#485a61] mb-4 lg:mb-6">Veterinary and Other Care</h2>
				<p class="text-sm lg:text-md text-[#485a61] opacity-80 mx-auto leading-relaxed">
					AHAS Home Veterinary Services provides basic veterinary care to people living with a very low income in Edmonton.  Our policy is to ensure all patients are spayed/neutered as long as they are healthy; we will not see your pets if you will not spay/neuter them.
				</p>
			</div>

			<ServicesList client:load />
		</section>

		<!-- Food Bank Section -->
		<section class="py-12 sm:py-16 px-4 sm:px-6 lg:px-8 max-w-6xl mx-auto">
			<h2 class="text-2xl sm:text-3xl lg:text-4xl font-bold text-[#485a61] mb-4 lg:mb-6">Pet Food Banks</h2>
			<p class="mb-4">Veterinary costs aside, pet owners face the additional costs of keeping their furry friends well-fed, healthy and happy.</p>
			<FoodBanksList client:load />
		</section>

		<!-- Quick Links Section -->
		<section class="py-12 sm:py-16 px-4 sm:px-6 lg:px-8 bg-gray-50">
			<div class="max-w-6xl mx-auto">
				<div class="text-center mb-8 lg:mb-12">
					<h2 class="text-2xl sm:text-3xl lg:text-4xl font-bold text-[#485a61] mb-4 lg:mb-6">Service Quick Links</h2>
				</div>
				
				<div class="grid grid-cols-1 md:grid-cols-3 gap-6 lg:gap-8">
					<div class="text-center">
						<a 
							href="/services/apply" 
							class="block bg-white p-6 rounded-lg shadow-lg border border-gray-200 hover:shadow-xl transition-all hover:scale-105"
						>
							<div class="w-16 h-16 bg-[#e25002] bg-opacity-10 rounded-lg flex items-center justify-center mx-auto mb-4">
								<svg class="w-8 h-8 text-[#e25002]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
								</svg>
							</div>
							<h3 class="text-xl font-bold text-[#485a61] mb-2">Apply for Services</h3>
							<p class="text-[#485a61] opacity-80 text-sm">Complete our application for veterinary care</p>
						</a>
					</div>

					<div class="text-center">
						<a 
							href="/resources" 
							class="block bg-white p-6 rounded-lg shadow-lg border border-gray-200 hover:shadow-xl transition-all hover:scale-105"
						>
							<div class="w-16 h-16 bg-[#19b8d7] bg-opacity-10 rounded-lg flex items-center justify-center mx-auto mb-4">
								<svg class="w-8 h-8 text-[#19b8d7]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
								</svg>
							</div>
							<h3 class="text-xl font-bold text-[#485a61] mb-2">Pet Care Resources</h3>
							<p class="text-[#485a61] opacity-80 text-sm">Guides and information for pet owners</p>
						</a>
					</div>

					<div class="text-center">
						<a 
							href="/faq" 
							class="block bg-white p-6 rounded-lg shadow-lg border border-gray-200 hover:shadow-xl transition-all hover:scale-105"
						>
							<div class="w-16 h-16 bg-[#fdb52b] bg-opacity-20 rounded-lg flex items-center justify-center mx-auto mb-4">
								<svg class="w-8 h-8 text-[#fdb52b]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.228 9c.549-1.165 2.03-2 3.772-2 2.21 0 4 1.343 4 3 0 1.4-1.278 2.575-3.006 2.907-.542.104-.994.54-.994 1.093m0 3h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
								</svg>
							</div>
							<h3 class="text-xl font-bold text-[#485a61] mb-2">Frequently Asked Questions</h3>
							<p class="text-[#485a61] opacity-80 text-sm">Find answers to common questions</p>
						</a>
					</div>
				</div>
			</div>
		</section>

		<!-- CTA Section -->
		<section class="py-12 sm:py-16 px-4 sm:px-6 lg:px-8 bg-gradient-to-br from-[#19b8d7] to-[#485a61]">
			<div class="max-w-4xl mx-auto text-center">
				<h2 class="text-2xl sm:text-3xl lg:text-4xl font-bold text-white mb-4 lg:mb-6">
					Ready to Get Help for Your Pet?
				</h2>
				<p class="text-lg sm:text-xl text-white opacity-90 mb-6 lg:mb-8 leading-relaxed max-w-3xl mx-auto">
					If you're experiencing financial hardship and need veterinary care for your pet, 
					we're here to help. Apply for our services today.
				</p>
				<div class="flex flex-col sm:flex-row gap-3 lg:gap-4 justify-center">
					<a 
						href="/services/apply" 
						class="bg-white hover:bg-gray-100 text-[#19b8d7] px-6 lg:px-8 py-3 lg:py-4 rounded-lg text-base lg:text-lg font-semibold transition-colors shadow-lg hover:shadow-xl transform hover:scale-105 whitespace-nowrap"
					>
						Apply for Services
					</a>
					<a 
						href="/contact" 
						class="border-2 border-white text-white hover:bg-white hover:text-[#485a61] px-6 lg:px-8 py-3 lg:py-4 rounded-lg text-base lg:text-lg font-semibold transition-colors whitespace-nowrap"
					>
						Contact Us
					</a>
				</div>
			</div>
		</section>
	</main>
</Layout>
