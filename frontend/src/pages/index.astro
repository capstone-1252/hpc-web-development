---
import Layout from "../layouts/Layout.astro"
import { YouTube } from "astro-embed"
import { PartnerList } from "@/components/Partners/PartnerList.tsx"
import School from "@/components/Icons/School.astro"
import Dog from "@/components/Icons/Dog.astro"
import DogBowl from "@/components/Icons/DogBowl.astro"
---

<Layout>
	<main class="bg-white">
		<!-- Hero Section -->
		<section class="relative bg-(--muted-blue) py-12 sm:py-16 lg:py-20 px-4 sm:px-6 lg:px-8">
			<div class="max-w-7xl mx-auto">
				<div class="grid lg:grid-cols-2 gap-8 lg:gap-12 items-center">
					<div class="lg:text-left">
						<h1 class="text-2xl sm:text-3xl lg:text-5xl font-bold text-(--dark-blue) mb-4 lg:mb-6 leading-tight">
							Saving Lives and Healing
							<span class="text-[#19b8d7] block lg:inline">Alberta's Animals</span>
						</h1>
						<p class="text-2xl sm:text-xl lg:text-2xl text-[#485a61] mb-6 lg:mb-8 leading-relaxed max-w-2xl mx-auto lg:mx-0">
							Alberta Helping Animals Society provides compassionate veterinary care, rescue services, 
							and support for pets and their families throughout Alberta.
						</p>
						<div class="flex flex-col sm:flex-row gap-3 lg:gap-4 justify-center lg:justify-start">
							<a 
								href="/donate" 
								class="bg-[#e25002] hover:bg-[#c44301] text-white px-6 lg:px-8 py-3 lg:py-4 rounded-lg text-base lg:text-lg font-semibold transition-colors shadow-lg transform hover:scale-105 whitespace-nowrap"
							>
								Donate Now
							</a>
							<a 
								href="/about-us" 
								class="bg-white hover:bg-gray-50 text-(--dark-blue) border-2 border-(--dark-blue) px-6 lg:px-8 py-3 lg:py-4 rounded-lg text-base lg:text-lg font-semibold transition-colors transform hover:scale-105 whitespace-nowrap"
							>
								Our Mission
							</a>
						</div>
					</div>
					<div class="">
						<img src="/hero-image.png" alt="" class="mx-auto ">
					</div>
				</div>
			</div>
		</section>

		<!-- Mission Section -->
		<section class="pt-12 sm:pt-16 px-4 sm:px-6 lg:px-8">
			<div class="max-w-6xl mx-auto">
				<div class="mb-8 lg:mb-12">
					<h2 class="text-2xl sm:text-3xl lg:text-4xl font-bold text-(--dark-blue) mb-4 lg:mb-6">
						Our Mission
					</h2>
					<div class="mx-auto">
						<YouTube id="6RzUmbe-hk0" class="min-w-full"/>
					</div>
					<p class="text-lg lg:text-xl text-[#485a61] mx-auto leading-relaxed my-6">
						Alberta Helping Animals Society is dedicated to providing compassionate veterinary care, 
						rescue services, and support for animals in need throughout Alberta.
					</p>
				</div>
				<div class="grid grid-cols-1 sm:grid-cols-3 gap-6 lg:gap-8 max-w-6xl bg-(--dark-blue) text-white p-6 rounded-tl-[200px] rounded-r-[100px] ">
					<div class="text-center">
						<div class="text-3xl sm:text-4xl font-bold mb-2">15+</div>
						<p class="text-sm sm:text-base font-medium">Years of Service</p>
					</div>
					<div class="text-center">
						<div class="text-3xl sm:text-4xl font-bold mb-2">$0</div>
						<p class="text-sm sm:text-base font-medium">Cost for Qualifying Individuals</p>
					</div>
					<div class="text-center">
						<div class="text-3xl sm:text-4xl font-bold mb-2">100%</div>
						<p class="text-sm sm:text-base font-medium">Dedicated to Animals</p>
					</div>
				</div>
			</div>
		</section>

		<!-- Services Overview Section -->
		<section class="pb-12 sm:pb-16 px-4 sm:px-6 lg:px-8 bg-[#fbfbfb]">
			<div class="max-w-6xl mx-auto">
				<div class="max-w-3xl mx-auto mb-4">
					<div class=" max-w-[300px] md:max-w-6xl bg-[#e6e6e6] rounded-b-[70px] p-5 px-6 mb-12">
						<h2 class="text-3xl lg:text-4xl font-bold text-(--dark-blue) mb-2 lg:mb-6 px-4">
							How We Help Alberta's Animals
						</h2>
					</div>
				</div>
				<div class="grid grid-cols-1 md:grid-cols-3 gap-6 lg:gap-8">
					<div class="bg-white p-6 lg:p-8 rounded-lg shadow-lg border border-gray-200 hover:shadow-xl transition-shadow flex flex-col h-full">
						<div class="w-12 h-12 lg:w-16 lg:h-16 rounded-lg flex items-center justify-center mb-4 lg:mb-6">
							<School />
						</div>
						<h3 class="text-lg lg:text-xl font-bold text-[#485a61] mb-3 lg:mb-4">Learning</h3>
						<p class="text-sm lg:text-base text-[#485a61] opacity-80 mb-4">
							We provide free learning resources and seminars about nutrition, behavior, and other aspects of animal care.
						</p>
						<a href="https://learning.ahas.ca" target="_blank" class="mt-auto text-(--dark-blue) font-semibold hover:text-(--dark-blue) transition-colors inline-flex items-center text-sm lg:text-base">
							Visit Our Learning Modules
							<svg class="ml-2 w-3 h-3 lg:w-4 lg:h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
							</svg>
						</a>
					</div>
					<div class="bg-white p-6 lg:p-8 rounded-lg shadow-lg border border-gray-200 hover:shadow-xl transition-shadow flex flex-col h-full">
						<div class="w-12 h-12 lg:w-16 lg:h-16 flex items-center justify-center mb-4 lg:mb-6">
							<Dog />
						</div>
						<h3 class="text-lg lg:text-xl font-bold text-[#485a61] mb-3 lg:mb-4">Veterinary Care</h3>
						<p class="text-sm lg:text-base text-[#485a61] opacity-80 mb-4">
							AHAS Home Veterinary Services provides no-cost veterinary services in  Edmonton to qualified clients who are not able to access regular veterinary care.
						</p>
						<a href="https://learning.ahas.ca" class="mt-auto text-(--dark-blue) font-semibold hover:text-(--dark-blue) transition-colors inline-flex items-center text-sm lg:text-base">
							See our Services
							<svg class="ml-2 w-3 h-3 lg:w-4 lg:h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
							</svg>
						</a>
					</div>
					<div class="bg-white p-6 lg:p-8 rounded-lg shadow-lg border border-gray-200 hover:shadow-xl transition-shadow flex flex-col h-full">
						<div class="w-12 h-12 lg:w-16 lg:h-16 flex items-center justify-center mb-4 lg:mb-6">
							<DogBowl />
						</div>
						<h3 class="text-lg lg:text-xl font-bold text-[#485a61] mb-3 lg:mb-4">Food & Supplies</h3>
						<p class="text-sm lg:text-base text-[#485a61] opacity-80 mb-4">
							AHAS Helps keep pet owners keep costs down while keeping their furry friends well-fed happy and healthy.
						</p>
						<a href="/services/wellness" class="mt-auto text-(--dark-blue) font-semibold hover:text-(--dark-blue) transition-colors inline-flex items-center text-sm lg:text-base">
							See Edmontons Food Banks
							<svg class="ml-2 w-3 h-3 lg:w-4 lg:h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
							</svg>
						</a>
					</div>
				</div>
			</div>
		</section>
		<!-- Rescue Stories Section -->
		<section class="py-12 sm:py-16 px-4 sm:px-6 lg:px-8">
			<div class="max-w-6xl mx-auto">
				<h2 class="text-2xl sm:text-3xl lg:text-4xl font-bold text-(--dark-blue) mb-8 lg:mb-12">
					Success Stories
				</h2>
				<div class="grid grid-cols-1 lg:grid-cols-2 gap-6 lg:gap-8 items-stretch">
					<div class="bg-white rounded-lg shadow-lg p-4 lg:p-6 border border-gray-200 h-full flex flex-col">
						<div class="flex items-start gap-3 lg:gap-4">
							<div class="w-12 h-12 lg:w-16 lg:h-16 bg-[#e25002] bg-opacity-10 rounded-lg flex items-center justify-center flex-shrink-0">
								<svg class="w-6 h-6 lg:w-8 lg:h-8 text-[#e25002]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z" />
								</svg>
							</div>
							<div class="flex-1">
								<h3 class="text-lg lg:text-xl font-bold text-(--dark-blue) mb-2">Cats Orthopedic Surgery</h3>
								<p class="text-sm lg:text-base text-[#485a61] opacity-80 mb-3">Yahoooo!  Wonderful bone saw!  This kitty will be pain free after major orthopaedic surgery!  Thanks to Dr Chris!</p>
								<div class="flex items-center gap-3 lg:gap-4 text-xs lg:text-sm">
									<span class="text-[#485a61] font-semibold">Buddy</span>
									<span class="text-[#485a61] opacity-70">•</span>
									<span class="text-[#485a61] opacity-70">2024</span>
								</div>
							</div>
						</div>
					</div>

					<div class="bg-white rounded-lg shadow-lg p-4 lg:p-6 border border-gray-200 h-full flex flex-col">
						<div class="flex items-start gap-3 lg:gap-4 flex-1">
							<div class="w-12 h-12 lg:w-16 lg:h-16 bg-[#19b8d7] bg-opacity-10 rounded-lg flex items-center justify-center flex-shrink-0">
								<svg class="w-6 h-6 lg:w-8 lg:h-8 text-[#19b8d7]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
								</svg>
							</div>
							<div class="flex-1">
								<h3 class="text-lg lg:text-xl font-bold text-(--dark-blue) mb-2">Community Support</h3>
								<p class="text-sm lg:text-base text-[#485a61] opacity-80 mb-3">Some wonderful person just made a massive anonymous donation to AHAS through Canada Helps.  We can't seem to see who donates (grr, I know you all get tax receipts but I want to thank you personally).</p>
								<div class="flex items-center gap-3 lg:gap-4 text-xs lg:text-sm">
									<span class="text-[#485a61] font-semibold">AHAS</span>
									<span class="text-[#485a61] opacity-70">•</span>
									<span class="text-[#485a61] opacity-70">2024</span>
								</div>
							</div>
						</div>
					</div>
				</div>
			</div>
		</section>




		<!-- Final CTA Section -->
		<section class="py-12 sm:py-16 px-4 sm:px-6 lg:px-8">
			<div class="max-w-6xl mx-auto">
				<div class="grid grid-cols-1 xl:grid-cols-2 gap-[128px]">
					<div class="bg-(--muted-blue) p-12 rounded-md min-w-xl">
					<h2 class="text-2xl sm:text-3xl lg:text-4xl font-bold text-black mb-4 lg:mb-6">
						Support Us
					</h2>
					<p class="text-lg sm:text-xl text-black opacity-90 mb-6 lg:mb-8 leading-relaxed max-w-3xl mx-auto">
						Join us in our mission to protect and care for Alberta's animals. Your donation 
						provides emergency medical care, shelter, and hope for animals in need.
					</p>
					<div class="flex flex-col sm:flex-row gap-12 lg:gap-12 justify-center">
						<a 
							href="/donate" 
							class="bg-primary text-(--muted-blue) px-6 lg:px-8 py-3 lg:py-4 rounded-lg text-base lg:text-lg font-semibold transition-colors shadow-lg hover:shadow-xl transform hover:scale-105 whitespace-nowrap"
						>
							Donate Now
						</a>
						<a 
							href="/get-involved" 
								class="border-2 border-primary text-primary px-6 lg:px-8 py-3 lg:py-4 rounded-lg text-base lg:text-lg font-semibold transition-colors whitespace-nowrap transform hover:scale-105"
						>
							Get Involved
						</a>
						</div>
					</div>
					<div class="mx-auto">
						<img src="/support-us.png" alt="">
					</div>
				</div>
			</div>
		</section>
		<section class="py-12 sm:py-16 px-4 sm:px-6 lg:px-8">
			<div class="max-w-6xl mx-auto">
				<h2 class="text-2xl sm:text-3xl lg:text-4xl font-bold mb-4 lg:mb-6">
					Our Partners
				</h2>
				<PartnerList client:load />
			</div>
		</section>
	</main>
</Layout>
