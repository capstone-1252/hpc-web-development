---
import Layout from "@/layouts/Layout.astro"
import { Image } from "astro:assets"
import volunteerHeroImage from "@/assets/volunteer-hero.avif"
---

<Layout title="Volunteer With Us - Alberta Helping Animals Society">
	<main class="bg-white">
    <!-- Hero Banner -->
    	<section class="bg-[#D1E9EE] py-2 sm:py-2 lg:py-5 px-4 sm:px-2 lg:px-4 overflow-x-hidden">
        <div class="max-w-7xl mx-auto">
          <div class="flex flex-col lg:flex-row items-center justify-between gap-10">
            <div class="max-w-2xl">
              <h1 class="text-3xl sm:text-4xl lg:text-4xl font-bold text-(--dark-blue) mb-6 leading-tight" style="font-family: 'Ubuntu', sans-serif;">
                Volunteer With Us
              </h1>
              <p class="text-lg text-[#485a61] leading-relaxed">
                Our volunteers are what make the Alberta Helping Animals Society possible
              </p>
            </div>
            <!-- Banner Image -->
            <div class="flex justify-center lg:justify-end w-full lg:w-1/2">
              <Image 
                src={volunteerHeroImage} 
                alt="Hero Banner for Volunteer Page"
                class="w-[260px] sm:w-[300px] md:w-[340px] lg:w-[400px] h-auto"
              />
            </div>
          </div>
        </div>
      </section>

    <!-- Volunteer Opportunities section -->
    <section class="min-h-screen flex items-center justify-center px-6 sm:px-8 lg:px-10 py-12 sm:py-16 lg:py-20">
     
      <div class="w-full max-w-7xl">
        <h2 class="text-3xl sm:text-3xl lg:text-3xl font-bold text-(--dark-blue) mb-8 lg:mb-12">Volunteer Opportunities</h2>
     
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
     
          <!-- Veterinary Assistance -->
          <div class="card bg-[#D1E9EE] rounded-xl p-6 flex flex-col gap-2">
            <h3 class="text-2xl font-bold text-gray-800">Veterinary Assistance</h3>
            <p class="text-gray-500 text-lg leading-relaxed">Assist veterinarians with basic support during clinics or animal care activities.</p>
          </div>
     
          <!-- Fundraising -->
          <div class="card bg-[#0C5E6E] rounded-xl p-6 flex flex-col gap-2">
            <h3 class="text-2xl font-bold text-white text-right">Fundraising</h3>
            <p class="text-teal-100 text-lg text-right leading-relaxed">Help organize and run fundraising events that support animal rescue and care.</p>
          </div>
     
          <!-- Ideas, Planning & Coordination -->
          <div class="card bg-[#D1E9EE] rounded-xl p-6 flex flex-col gap-2">
            <h3 class="text-2xl font-bold text-gray-800">Ideas, Planning, &amp; Coordination</h3>
            <p class="text-gray-500 text-lg leading-relaxed">Contribute creative ideas and help plan events, campaigns, and community outreach.</p>
          </div>
     
          <!-- Driving -->
          <div class="card bg-[#0C5E6E] rounded-xl p-6 flex flex-col gap-2">
            <h3 class="text-2xl font-bold text-white text-right">Driving</h3>
            <p class="text-teal-100 text-lg text-right leading-relaxed">Transport animals, supplies, or volunteers when needed.</p>
          </div>
     
          <!-- Seminars -->
          <div class="card bg-[#D1E9EE] rounded-xl p-6 flex flex-col gap-2">
            <h3 class="text-2xl font-bold text-gray-800">Seminars</h3>
            <p class="text-gray-500 text-lg leading-relaxed">Help organize or assist with educational seminars and awareness events.</p>
          </div>
     
          <!-- Planning and/or Speaking -->
          <div class="card bg-[#0C5E6E] rounded-xl p-6 flex flex-col gap-2">
            <h3 class="text-2xl font-bold text-white text-right">Planning and/or Speaking</h3>
            <p class="text-teal-100 text-lg text-right leading-relaxed">Represent the organization at community events, presentations, or information sessions.</p>
          </div>
     
          <!-- Social Media & Web -->
          <div class="card bg-[#D1E9EE] rounded-xl p-6 flex flex-col gap-2">
            <h3 class="text-2xl font-bold text-gray-800">Social Media &amp; Web</h3>
            <p class="text-gray-500 text-lg leading-relaxed">Help manage social media accounts, update website content, or assist with online promotion.</p>
          </div>
     
          <!-- Brochure Design -->
          <div class="card bg-[#0C5E6E] rounded-xl p-6 flex flex-col gap-2">
            <h3 class="text-2xl font-bold text-white text-right">Brochure Design</h3>
            <p class="text-teal-100 text-lg text-right leading-relaxed">Assist in creating brochures and promotional materials for events and campaigns.</p>
          </div>
     
        </div>
        <div class="mb-5">
            <h2 class="text-3xl sm:text-3xl lg:text-3xl font-bold text-(--dark-blue) mt-8">Interested in helping animals and making a difference?</h2>
            <p class="max-w-[500px] text-lg mt-2 mb-8">If you meet the requirements and are committed to supporting our work and the animals in our care, 
            we encourage you to contact us to learn more about available volunteer opportunities.</p>
            <a href="#" class="bg-[#FF5600] hover:bg-[#c44301] text-white px-6 lg:px-8 py-3 lg:py-4 rounded-xl text-base lg:text-lg font-semibold transition-all shadow-lg hover:shadow-xl hover:-translate-y-0.5 whitespace-nowrap">Apply for Volunteering</a>
        </div>
      </div>
      
    </section>

    </main>

</Layout>
