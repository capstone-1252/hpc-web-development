---
import Layout from "@/layouts/Layout.astro"
---

<Layout title="Volunteer With Us - Alberta Helping Animals Society">
	<main class="bg-white">

    	<section class="bg-(--muted-blue) py-12 sm:py-16 lg:py-20 px-6 sm:px-8 lg:px-10">
			<div class="max-w-7xl mx-auto">
				<div class="flex flex-col lg:flex-row gap-8 lg:gap-12 items-center">
					<div class="flex-1 lg:text-left">
						<h1 class="text-3xl sm:text-2xl lg:text-5xl font-bold text-(--dark-blue) mb-6 leading-tight" style="font-family: 'Ubuntu', sans-serif;">
							Volunteer With Us
						</h1>
						<p class="text-lg sm:text-xl lg:text-2xl text-[#485a61] text-foreground leading-relaxed max-w-2xl mx-auto lg:mx-0">
              Our volunteers are what make the Alberta Helping Animals Society possible
						</p>
					</div>
					<div class="flex-shrink-0 w-full lg:w-1/2">
            <!-- image will go here -->
					</div>
				</div>
			</div>
		</section>

    <!-- Volunteer Opportunities section -->
    <section class="min-h-screen flex items-center justify-center px-6 sm:px-8 lg:px-10 py-12 sm:py-16 lg:py-20">
     
      <div class="w-full max-w-7xl">
        <h2 class="text-2xl sm:text-3xl lg:text-4xl font-bold text-(--dark-blue) mb-8 lg:mb-12">Volunteer Opportunities</h2>
     
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
     
          <!-- Veterinary Assistance -->
          <div class="card bg-[#D1E9EE] rounded-xl p-6 flex flex-col gap-2">
            <h2 class="font-bold text-gray-800 text-base">Veterinary Assistance</h2>
            <p class="text-gray-500 text-sm leading-relaxed">Assist veterinarians with basic support during clinics or animal care activities.</p>
          </div>
     
          <!-- Fundraising -->
          <div class="card bg-[#15A1BD] rounded-xl p-6 flex flex-col gap-2">
            <h2 class="font-bold text-white text-right">Fundraising</h2>
            <p class="text-teal-100 text-sm text-right leading-relaxed">Help organize and run fundraising events that support animal rescue and care.</p>
          </div>
     
          <!-- Ideas, Planning & Coordination -->
          <div class="card bg-[#D1E9EE] rounded-xl p-6 flex flex-col gap-2">
            <h2 class="font-bold text-gray-800 text-base">Ideas, Planning, &amp; Coordination</h2>
            <p class="text-gray-500 text-sm leading-relaxed">Contribute creative ideas and help plan events, campaigns, and community outreach.</p>
          </div>
     
          <!-- Driving -->
          <div class="card bg-[#15A1BD] rounded-xl p-6 flex flex-col gap-2">
            <h2 class="font-bold text-white text-right">Driving</h2>
            <p class="text-teal-100 text-sm text-right leading-relaxed">Transport animals, supplies, or volunteers when needed.</p>
          </div>
     
          <!-- Seminars -->
          <div class="card bg-[#D1E9EE] rounded-xl p-6 flex flex-col gap-2">
            <h2 class="font-bold text-gray-800 text-base">Seminars</h2>
            <p class="text-gray-500 text-sm leading-relaxed">Help organize or assist with educational seminars and awareness events.</p>
          </div>
     
          <!-- Planning and/or Speaking -->
          <div class="card bg-[#15A1BD] rounded-xl p-6 flex flex-col gap-2">
            <h2 class="font-bold text-white text-right">Planning and/or Speaking</h2>
            <p class="text-teal-100 text-sm text-right leading-relaxed">Represent the organization at community events, presentations, or information sessions.</p>
          </div>
     
          <!-- Social Media & Web -->
          <div class="card bg-[#D1E9EE] rounded-xl p-6 flex flex-col gap-2">
            <h2 class="font-bold text-gray-800 text-base">Social Media &amp; Web</h2>
            <p class="text-gray-500 text-sm leading-relaxed">Help manage social media accounts, update website content, or assist with online promotion.</p>
          </div>
     
          <!-- Brochure Design -->
          <div class="card bg-[#15A1BD] rounded-xl p-6 flex flex-col gap-2">
            <h2 class="font-bold text-white text-right">Brochure Design</h2>
            <p class="text-teal-100 text-sm text-right leading-relaxed">Assist in creating brochures and promotional materials for events and campaigns.</p>
          </div>
     
        </div>
        <div class="mb-5">
            <h2 class="text-2xl sm:text-xl lg:text-2xl font-bold text-(--dark-blue) mt-8">Interested in helping animals and making a difference?</h2>
            <p class="max-w-[500px] mt-2 mb-8">If you meet the requirements and are committed to supporting our work and the animals in our care, 
            we encourage you to contact us to learn more about available volunteer opportunities.</p>
            <a href="#" class="bg-[#e25002] hover:bg-[#c44301] text-white px-6 lg:px-8 py-3 lg:py-4 rounded-md text-base lg:text-lg font-semibold transition-colors shadow-lg transform hover:scale-105 whitespace-nowrap">Apply for Volunteering</a>
        </div>
      </div>
      
    </section>

    </main>

</Layout>
