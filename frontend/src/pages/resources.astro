---
import Layout from "@/layouts/Layout.astro"
import { ResourcesList } from "@/components/Resources/ResourcesList"
import { Image } from "astro:assets"
import resourcesHeroImage from "@/assets/resources-hero.avif"
---
<Layout>
   <main class="bg-white">
      <!-- HERO -->
      <section class="bg-(--primary) py-12 sm:py-16 lg:py-20 px-4 sm:px-6 lg:px-8 overflow-x-hidden">
         <div class="max-w-2xl lg:max-w-7xl mx-auto">
            <div class="flex flex-col lg:flex-row items-center gap-8">
               <!-- Content -->
               <div class="w-full lg:w-1/2">
                  <h1 class="text-2xl sm:text-3xl lg:text-4xl font-bold text-(--dark-blue) mb-4 lg:mb-6 leading-tight break-words">
                     <span class="text-[var(--dark-blue)] block">Animal Care Resources:</span>
                     <span class="text-[var(--hero-blue)] block">Cats and Dogs</span>
                  </h1>
                  <p class="text-lg sm:text-xl text-[var(--muted-foreground)] mb-6 lg:mb-8 leading-relaxed max-w-2xl lg:mx-0">
                     Dedicated to creating opportunities for vulnerable people to access veterinary care and other 
                     services for their companion animals.
                  </p>
               </div>
               <!-- Image -->
               <div class="w-full lg:w-1/2 flex justify-center lg:justify-end">
                  <Image 
                     src={resourcesHeroImage} 
                     alt="Hero Banner for Resources Page"
                     class="w-[420px] sm:w-[400px] md:w-[350px] lg:w-[500px] max-w-none pointer-events-none select-none"
                     />
               </div>
            </div>
         </div>
      </section>
      <!-- MAIN CONTENT -->
      <section class="py-12 sm:py-16 lg:py-10">
         <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <!-- Title -->
            <h2 class="text-3xl text-[var(--dark-blue)] font-semibold text-gray-800 mb-6">
               Cat Care
            </h2>
            <ResourcesList client:load />
            <!-- Learning Modules -->
            <div class="mb-10">
               <h3 class="text-2xl text-gray-700 mb-4">
                  Cat Care Learning Modules
               </h3>
               <div class="flex flex-wrap gap-4">
                  <a href="#" class="bg-[#0C5E6E] text-white text-lg px-6 py-2 rounded-full shadow-md hover:opacity-90 transition">
                  Preventing and Treating Diabetes in Your Cat
                  </a>
                  <a href="#" class="bg-[var(--primary)] text-[var(--dark-blue)] text-lg px-6 py-2 rounded-full shadow-md hover:opacity-90 transition">
                  Nutrition and How to Feed Your Cat
                  </a>
                  <a 
				  href="https://app.mindsmith.ai/learn/cm8pday1m005y808vt9r5ey20" 
				  target="_blank" 
				  class="bg-[#0C5E6E] text-white text-lg px-6 py-2 rounded-full shadow-md hover:opacity-90 transition">
                  The Catkins Diet: Feeding Your Overweight Cat on a Budget
                  </a>
               </div>
            </div>
            <!-- Learning Videos -->
            <div class="mb-10">
               <h3 class="text-[var(--dark-blue)] text-2xl text-gray-700 mb-4">
                  Cat Care Learning Videos
               </h3>
               <div class="flex flex-wrap gap-x-9 gap-y-5">
                  <a href="#" class="bg-[#0C5E6E] text-white text-lg px-10 py-2 rounded-full shadow-md hover:opacity-90 transition">
                  How to Pill a Cat
                  </a>
                  <a href="#" class="bg-[var(--primary)] text-[var(--dark-blue)] text-lg px-10 py-2 rounded-full shadow-md hover:opacity-90 transition">
                  How to Trim Nails
                  </a>
                  <a href="#" class="bg-[#0C5E6E] text-white text-lg px-10 py-2 rounded-full shadow-md hover:opacity-90 transition">
                  Video: How to make a cone for your cat!
                  </a>
                  <a href="#" class="bg-[var(--primary)] text-[var(--dark-blue)] text-lg px-10 py-2 rounded-full shadow-md hover:opacity-90 transition">
                  How to Use an Insulin Pen
                  </a>
                  <a href="#" class="bg-[#0C5E6E] text-white text-lg px-10 py-2 rounded-full shadow-md hover:opacity-90 transition">
                  How to Give Liquid Medication in the Mouth
                  </a>
                  <a href="#" class="bg-[var(--primary)] text-[var(--dark-blue)] text-lg px-10 py-2 rounded-full shadow-md hover:opacity-90 transition">
                  How to Test Blood Glucose Using a Glucometer
                  </a>
                  <a href="#" class="bg-[#0C5E6E] text-white text-lg px-10 py-2 rounded-full shadow-md hover:opacity-90 transition">
                  How to Give Liquid Medication in the Cheek Pouch
                  </a>
               </div>
            </div>
            <!-- Cat diet plan app -->
            <div>
               <a href="https://ahascatweightloss.netlify.app/" class="bg-[var(--secondary)] hover:bg-[var(--secondary-hover)] text-[var(--muted)] px-10 lg:px-8 py-5 lg:py-4 rounded-xl text-base lg:text-lg font-semibold transition-all shadow-lg hover:shadow-xl hover:-translate-y-0.5 justify-left w-fit">
               Design a diet plan for your cat as part of the Catkins Diet (App)
               </a>
            </div>
         </div>
      </section>
      <section class="py-12 sm:py-16 lg:py-10">
         <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <!-- Title -->
            <h2 class="text-3xl text-[var(--dark-blue)] font-semibold text-gray-800 mb-6">
               Dog Care
            </h2>
            <!-- Learning Modules -->
            <div class="mb-10">
               <h3 class="text-[var(--dark-blue)] text-2xl text-gray-700 mb-4">
                  Dog Care Learning Modules
               </h3>
               <div class="flex flex-wrap gap-4">
                  <a href="#" class="bg-[#0C5E6E] text-white text-lg px-6 py-2 rounded-full shadow-md hover:opacity-90 transition">
                  Dog Nutrition
                  </a>
                  <a href="#" class="bg-[var(--primary)] text-[var(--dark-blue)] text-lg px-6 py-2 rounded-full shadow-md hover:opacity-90 transition">
                  Preventing and Treating Diabetes in Your Dog
                  </a>
                  <a href="#" class="bg-[#0C5E6E] text-white text-lg px-6 py-2 rounded-full shadow-md hover:opacity-90 transition">
                  Nutrition and How to Feed Your Dog
                  </a>
               </div>
            </div>
            <!-- Learning Videos -->
            <div class="mb-10">
               <h3 class="text-2xl text-gray-700 mb-4">
                  Dog Care Learning Videos
               </h3>
               <div class="flex flex-wrap gap-x-9 gap-y-5">
                  <a href="#" class="bg-[#0C5E6E] text-white text-lg px-5 py-2 rounded-full shadow-md hover:opacity-90 transition">
                  How to Pill a Dog
                  </a>
                  <a href="#" class="bg-[var(--primary)] text-[var(--dark-blue)] text-lg px-5 py-2 rounded-full shadow-md hover:opacity-90 transition">
                  How to Trim Nails
                  </a>
                  <a href="#" class="bg-[#0C5E6E] text-white text-lg px-5 py-2 rounded-full shadow-md hover:opacity-90 transition">
                  Body Condition Score - Is Your Dog Overweight?
                  </a>
                  <a href="#" class="bg-[var(--primary)] text-[var(--dark-blue)] text-lg px-5 py-2 rounded-full shadow-md hover:opacity-90 transition">
                  Video: How to Make a Cone for Your Dog
                  </a>
                  <a href="#" class="bg-[#0C5E6E] text-white text-lg px-5 py-2 rounded-full shadow-md hover:opacity-90 transition">
                  How to Use an Insulin Pen
                  </a>
                  <a href="#" class="bg-[var(--primary)] text-[var(--dark-blue)] text-lg px-5 py-2 rounded-full shadow-md hover:opacity-90 transition">
                  How to Give Liquid Medication in the Mouth
                  </a>
                  <a href="#" class="bg-[#0C5E6E] text-white text-lg px-5 py-2 rounded-full shadow-md hover:opacity-90 transition">
                  How to Test Blood Glucose Using a Glucometer
                  </a>
                  <a href="#" class="bg-[var(--primary)] text-[var(--dark-blue)] text-lg px-5 py-2 rounded-full shadow-md hover:opacity-90 transition">
                  How to Give Liquid Medication in the Cheek Pouch
                  </a>
               </div>
            </div>
         </div>
      </section>
   </main>
</Layout>