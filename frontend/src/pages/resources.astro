---
import Layout from "@/layouts/Layout.astro"
import { ResourcesList } from "@/components/Resources/ResourcesList"
---
<Layout>
   <main class="bg-white">
      <!-- HERO -->
      <section class="relative bg-[#D1E9EE] py-12 sm:py-16 lg:py-20 overflow-hidden h-[420px]">
         <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative h-[265px]">
            <!-- Background image -->
            <img 
                  src="/hero/resources-hero.png" 
                  alt="Hero Banner for Resources Page" 
                  class="absolute bottom-0 right-0 w-[700px] sm:w-[500px] md:w-[700px] lg:w-[1000px] 
                  opacity-20 pointer-events-none select-none"
               />
            <!-- Content -->
            <div class="relative z-10 pt-13">
                  <h1 class="text-4xl sm:text-5xl lg:text-4xl font-bold leading-tight mb-6">
                     <span class="text-black block">Animal Care Resources:</span>
                     <span class="text-[#126F82] block">Cats and Dogs</span>
                  </h1>
                  <p class="text-lg sm:text-xl lg:text-lg text-[#485a61]  max-w-3xl leading-relaxed">
                     Dedicated to creating opportunities for vulnerable people to access veterinary care and other 
                     services   for their companion animals.</p>
            </div>
         </div>
      </section>
      <!-- MAIN CONTENT -->
      <section class="py-12 sm:py-16 lg:py-10">
         <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <!-- Title -->
            <h2 class="text-3xl font-semibold text-gray-800 mb-6">
               Cat Care
            </h2>
            <!-- Learning Modules -->
            <div class="mb-10">
               <h3 class="text-2xl text-gray-700 mb-4">
                  Cat Care Learning Modules
               </h3>
               <div class="flex flex-wrap gap-4">
                  <a href="#" class="bg-[#0C5E6E] text-white text-lg px-6 py-2 rounded-full shadow-md hover:opacity-90 transition">
                  Preventing and Treating Diabetes in Your Cat
                  </a>
                  <a href="#" class="bg-[#D1E9EE] text-black text-lg px-6 py-2 rounded-full shadow-md hover:opacity-90 transition">
                  Nutrition and How to Feed Your Cat
                  </a>
                  <a 
				  href="https://app.mindsmith.ai/learn/cm8pday1m005y808vt9r5ey20" 
				  target="_blank" 
				  class="bg-[#0C5E6E] text-white text-lg px-6 py-2 rounded-full shadow-md hover:opacity-90 transition">
                  The Catkins Diet: Feeding Your Overweight Cat on a Budget
                  </a>
               </div>
            </div>
            <!-- Learning Videos -->
            <div class="mb-10">
               <h3 class="text-2xl text-gray-700 mb-4">
                  Cat Care Learning Videos
               </h3>
               <div class="flex flex-wrap gap-x-9 gap-y-5">
                  <a href="#" class="bg-[#0C5E6E] text-white text-lg px-10 py-2 rounded-full shadow-md hover:opacity-90 transition">
                  How to Pill a Cat
                  </a>
                  <a href="#" class="bg-[#D1E9EE] text-black text-lg px-10 py-2 rounded-full shadow-md hover:opacity-90 transition">
                  How to Trim Nails
                  </a>
                  <a href="#" class="bg-[#0C5E6E] text-white text-lg px-10 py-2 rounded-full shadow-md hover:opacity-90 transition">
                  Video: How to make a cone for your cat!
                  </a>
                  <a href="#" class="bg-[#D1E9EE] text-black text-lg px-10 py-2 rounded-full shadow-md hover:opacity-90 transition">
                  How to Use an Insulin Pen
                  </a>
                  <a href="#" class="bg-[#0C5E6E] text-white text-lg px-10 py-2 rounded-full shadow-md hover:opacity-90 transition">
                  How to Give Liquid Medication in the Mouth
                  </a>
                  <a href="#" class="bg-[#D1E9EE] text-black text-lg px-10 py-2 rounded-full shadow-md hover:opacity-90 transition">
                  How to Test Blood Glucose Using a Glucometer
                  </a>
                  <a href="#" class="bg-[#0C5E6E] text-white text-lg px-10 py-2 rounded-full shadow-md hover:opacity-90 transition">
                  How to Give Liquid Medication in the Cheek Pouch
                  </a>
               </div>
            </div>
            <!-- CTA -->
            <div>
               <a href="https://ahascatweightloss.netlify.app/" class="bg-[#FF5600] hover:bg-[#c44301] text-white px-1 md:px-3 lg:px-8 py-3 lg:py-4 rounded-xl text-base lg:text-lg font-semibold transition-all shadow-lg hover:shadow-xl hover:-translate-y-0.5 whitespace-nowrap">
               Design a diet plan for your cat as part of the Catkins Diet (App)
               </a>
            </div>
         </div>
      </section>
      <section class="py-12 sm:py-16 lg:py-10">
         <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <!-- Title -->
            <h2 class="text-3xl font-semibold text-gray-800 mb-6">
               Dog Care
            </h2>
            <!-- Learning Modules -->
            <div class="mb-10">
               <h3 class="text-2xl text-gray-700 mb-4">
                  Dog Care Learning Modules
               </h3>
               <div class="flex flex-wrap gap-4">
                  <a href="#" class="bg-[#0C5E6E] text-white text-lg px-6 py-2 rounded-full shadow-md hover:opacity-90 transition">
                  Dog Nutrition
                  </a>
                  <a href="#" class="bg-[#D1E9EE] text-black text-lg px-6 py-2 rounded-full shadow-md hover:opacity-90 transition">
                  Preventing and Treating Diabetes in Your Dog
                  </a>
                  <a href="#" class="bg-[#0C5E6E] text-white text-lg px-6 py-2 rounded-full shadow-md hover:opacity-90 transition">
                  Nutrition and How to Feed Your Dog
                  </a>
               </div>
            </div>
            <!-- Learning Videos -->
            <div class="mb-10">
               <h3 class="text-2xl text-gray-700 mb-4">
                  Dog Care Learning Videos
               </h3>
               <div class="flex flex-wrap gap-x-9 gap-y-5">
                  <a href="#" class="bg-[#0C5E6E] text-white text-lg px-5 py-2 rounded-full shadow-md hover:opacity-90 transition">
                  How to Pill a Dog
                  </a>
                  <a href="#" class="bg-[#D1E9EE] text-black text-lg px-5 py-2 rounded-full shadow-md hover:opacity-90 transition">
                  How to Trim Nails
                  </a>
                  <a href="#" class="bg-[#0C5E6E] text-white text-lg px-5 py-2 rounded-full shadow-md hover:opacity-90 transition">
                  Body Condition Score - Is Your Dog Overweight?
                  </a>
                  <a href="#" class="bg-[#D1E9EE] text-black text-lg px-5 py-2 rounded-full shadow-md hover:opacity-90 transition">
                  Video: How to Make a Cone for Your Dog
                  </a>
                  <a href="#" class="bg-[#0C5E6E] text-white text-lg px-5 py-2 rounded-full shadow-md hover:opacity-90 transition">
                  How to Use an Insulin Pen
                  </a>
                  <a href="#" class="bg-[#D1E9EE] text-black text-lg px-5 py-2 rounded-full shadow-md hover:opacity-90 transition">
                  How to Give Liquid Medication in the Mouth
                  </a>
                  <a href="#" class="bg-[#0C5E6E] text-white text-lg px-5 py-2 rounded-full shadow-md hover:opacity-90 transition">
                  How to Test Blood Glucose Using a Glucometer
                  </a>
                  <a href="#" class="bg-[#D1E9EE] text-black text-lg px-5 py-2 rounded-full shadow-md hover:opacity-90 transition">
                  How to Give Liquid Medication in the Cheek Pouch
                  </a>
               </div>
            </div>
         </div>
      </section>
   </main>
</Layout>