
---
import Layout from "@/layouts/Layout.astro"
import { ResourcesList } from "@/components/Resources/ResourcesList"
---

<Layout>
	<main class="bg-white">
		<ResourcesList client:load />
		<section class="relative bg-gradient-to-br from-[#e8f4f7] to-[#d1e9ee] py-12 sm:py-16 lg:py-20 px-4 sm:px-6 lg:px-8">
			<div class="max-w-7xl mx-auto text-center">
				<h1 class="text-3xl sm:text-4xl lg:text-5xl font-bold text-[#485a61] mb-6 lg:mb-8">Animal Care Resources:</h1>
				<h2 class="text-3xl sm:text-4xl lg:text-5xl font-bold text-[#15A1BD] mb-6 lg:mb-8">Cats and Dogs</h2>
				<p class="text-lg sm:text-xl lg:text-2xl text-[#485a61] opacity-80 max-w-4xl mx-auto leading-relaxed">
					Dedicated to creating opportunities for vulnerable people to access veterinary care and other services for their companion animals.
				</p>
			</div>
		</section>

		<!-- Main Content -->
		<section>
			<div>
				<h1>Cat Care</h1>
				<div>
					<h3>Cat Care Learning Modules</h3>
					<a href=""class="bg-[#19b8d7]">Preventing and Treating Diabetes in your Cat</a>
					<a href=""class="bg-[#D1E9EE]">Nutrition and How to Feed Your Cat</a>
					</br>
					<a href="">The Catkins Diet: Feeding Your Overweight Cat on a Budget</a>
				</div>
			</div>
			<div>
				<h1>Cat Care Learning Videos</h1>
				<a href="">How to Pill a Cat</a></br>
				<a href="">How to Trim Nails</a></br>
				<a href="">Body Condition Score - Is Your Cat Overweight?</a></br>
				<a href="">Video: How to make a cone for your cat!</a></br>
				<a href="">How to Use an Insulin Pen</a></br>
				<a href="">How to Give Liquid Medication in the Mouth</a></br>
				<a href="">How to Test Blood Glucose Using a Glucometer</a></br>
				<a href="">How to Give Liquid Medication in the Cheek Pouch</a>
			</div>
			<div>
				<a href="">Design a diet plan for your cat as part of the Catkins Diet</a>
			</div>
		</section>

		<section>
			<div>
				<h1>Dog Care</h1>
				<div>
					<h3>Dog Care Learning Modules</h3>
					<a href="">Dog Nutrition</a>
					<a href="">Preventing and Treating Diabetes in your Dog</a>
					</br>
					<a href="">Nutrition and How to Feed Your Dog</a>
				</div>
			</div>
			<div>
				<h1>Dog Care Learning Videos</h1>
				<a href="">How to Pill a Dog</a></br>
				<a href="">How to Trim Nails</a></br>
				<a href="">Body Condition Score - Is Your Dog Overweight?</a></br>
				<a href="">Video: How to make a cone for your dog!</a></br>
				<a href="">How to Use an Insulin Pen</a></br>
				<a href="">How to Give Liquid Medication in the Mouth</a></br>
				<a href="">How to Test Blood Glucose Using a Glucometer</a></br>
				<a href="">How to Give Liquid Medication in the Cheek Pouch</a>
			</div>
		</section>
	</main>
</Layout>
