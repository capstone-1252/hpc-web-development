---
import Layout from "@/layouts/Layout.astro"
import { ResourcesList } from "@/components/Resources/ResourcesList"
import { Image } from "astro:assets"
import resourcesHeroImage from "@/assets/resources-hero.avif"
---
<Layout>
   <main class="bg-white">
      <!-- HERO -->
      <section class="bg-(--primary) py-2 sm:py-2 lg:py-5 px-4 sm:px-2 lg:px-4 overflow-x-hidden">
         <div class="max-w-2xl md:max-w-5xl lg:max-w-7xl mx-auto">
            <div class="flex flex-col lg:flex-row items-center gap-8 md:pl-3">
               <!-- Content -->
               <div class="w-full lg:w-1/2">
                  <h1 class="text-3xl sm:text-3xl lg:text-4xl font-bold text-(--dark-blue) lg:mb-1 mt-3 leading-tight break-words">
                     Animal Care Resources
                  </h1>
                  <h2 class="text-2xl sm:text-2xl lg:text-3xl font-bold text-(--hero-blue) mb-4 lg:mb-6 leading-tight break-words">Cats and Dogs</h2>
                  <p class="text-lg sm:text-xl text-[var(--muted-foreground)] mb-6 lg:mb-8 leading-relaxed max-w-2xl lg:mx-0">
                     Dedicated to creating opportunities for vulnerable people to access veterinary care and other services for their companion animals.
                  </p>
               </div>
               <div class="w-full lg:w-1/2 flex lg:justify-end">
                  <Image 
                     src={resourcesHeroImage} 
                     alt="Hero Banner for Resources Page"
                     class="w-[420px] sm:w-[400px] md:w-[350px] lg:w-[500px] max-w-none"
                     />
               </div>
            </div>
         </div>
      </section>
      <ResourcesList client:load />
   </main>
</Layout>
