
---
import Layout from "@/layouts/Layout.astro"
import "@/styles/global.css"
import { ResourcesList } from "@/components/Resources/ResourcesList"
---

<Layout>
	<main class="bg-white">

		<!-- Hero Section -->
		<section class="relative bg-gradient-to-br from-[#e8f4f7] to-[#d1e9ee] py-12 sm:py-16 lg:py-20 px-4 sm:px-6 lg:px-8">
			<div class="max-w-7xl mx-auto text-center">
				<h1 class="text-3xl sm:text-4xl lg:text-5xl font-bold text-[#485a61] mb-6">
					Animal Care Resources
				</h1>
				<p class="text-lg sm:text-xl text-[#485a61] opacity-80 max-w-4xl mx-auto">
					Dedicated to creating opportunities for vulnerable people to access veterinary care and other services for their companion animals.
				</p>
			</div>
		</section>

		<!-- Cat Care -->
		<section class="py-12 sm:py-16 px-4 sm:px-6 lg:px-8 bg-gray-50">
			<div class="max-w-6xl mx-auto">
				<h2 class="text-2xl sm:text-3xl font-bold text-[#485a61] mb-6 text-center">
					Cat Care
				</h2>

				<h3 class="text-xl font-semibold text-[#485a61] mb-4">
					Cat Care Learning Modules
				</h3>

				<ul class="list-none list-inside space-y-2 mb-8 text-[#485a61]">
					<li>Preventing and Treating Diabetes in Your Cat</li>
					<li>Nutrition and How to Feed Your Cat</li>
					<li>The Catkins Diet: Feeding Your Overweight Cat on a Budget</li>
				</ul>

				<h3 class="text-xl font-semibold text-[#485a61] mb-4">
					Cat Care Learning Videos
				</h3>

				<ul class="list-none list-inside space-y-2 mb-8 text-[#485a61]">
					<li>How to Pill a Cat</li>
					<li>How to Trim Nails</li>
					<li>Body Condition Score – Is Your Cat Overweight?</li>
					<li><a 
					href="https://www.youtube.com/watch?v=meEBLQUC-eM" 
					style="color:#e25002; text-decoration:underline;" 
					target="_blank" 
					rel="noopener noreferrer" >
					Video: How to make a cone for your cat!</a></li>
					<li> <a 
					href="https://www.youtube.com/watch?v=IjuB8E-CW-Y"
					style="color:#e25002; text-decoration:underline;" 
					target="_blank" 
					rel="noopener noreferrer">
					How to Use an Insulin Pen </a></li>
					<li>How to Test Blood Glucose Using a Glucometer</li>
					<li>How to Give Liquid Medication in the Mouth</li>
					<li>How to Give Liquid Medication in the Cheek Pouch</li>
				</ul>

				<h3 class="text-xl font-semibold text-[#485a61] mb-4">
					Interactive Tool
				</h3>

				<div class="mt-6">
				<a
					href="https://ahascatweightloss.netlify.app/"
					target="_blank"
					rel="noopener noreferrer"
					class="inline-block rounded-md bg-[#e25002] px-6 py-3 font-semibold text-white transition hover:bg-[#c84302]"
				>
					Design a diet plan for your cat as part of the Catkins Diet
				</a>
			</div>

			</div>
		</section>

		<!-- Dog Care -->
		<section class="py-12 sm:py-16 px-4 sm:px-6 lg:px-8 bg-white">
			<div class="max-w-6xl mx-auto">
				<h2 class="text-2xl sm:text-3xl font-bold text-[#485a61] mb-6 text-center">
					Dog Care
				</h2>

				<h3 class="text-xl font-semibold text-[#485a61] mb-4">
					Dog Care Learning Modules
				</h3>

				<ul class="list-none list-inside space-y-2 mb-8 text-[#485a61]">
					<li>Dog Nutrition</li>
				</ul>

				<h3 class="text-xl font-semibold text-[#485a61] mb-4">
					Dog Care Learning Videos
				</h3>

				<ul class="list-none list-inside space-y-2 text-[#485a61]">
					<li>Nail Trim</li>
					<li>Body Condition Score – Is Your Dog Overweight?</li>
				</ul>
			</div>
		</section>

	</main>
</Layout>