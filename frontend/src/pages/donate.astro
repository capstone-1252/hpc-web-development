---
import Layout from "@/layouts/Layout.astro"

---
<Layout title="Donate - Alberta Helping Animals Society">
   <main class="bg-white"></main>
   <!-- HERO -->
   <section class="bg-[#D1E9EE] py-2 sm:py-2 lg:py-5 px-4 sm:px-2 lg:px-4 overflow-x-hidden">
      <div class="max-w-2xl lg:max-w-7xl mx-auto">
         <div class="flex flex-col lg:flex-row items-center gap-8">
            <!-- Content -->
            <div class="w-full lg:w-1/2">
               <h1 class="text-2xl sm:text-3xl lg:text-4xl font-bold text-(--dark-blue) mb-4 lg:mb-6 leading-tight break-words">
                  Donate Now!
               </h1>
               <p class="text-lg sm:text-xl text-[var(--muted-foreground)] mb-6 lg:mb-8 leading-relaxed max-w-2xl lg:mx-0">Our volunteers are what make the Alberta Helping Animals Society possible.</p>
            </div>
            <!-- Banner Image here if needed -->
         </div>
      </div>
   </section>

	<section>
        <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
        	<p class="text-[var(--muted-foreground)] w-[928px] text-lg mt-2 mb-8">Your support can make a real difference in the lives of animals in need. Every donation, no matter how big or small, helps us provide food, shelter, medical care, and love to the animals we rescue. By donating to our cause, you are directly contributing to the well-being and happiness of countless animals who rely on our services. Your generosity allows us to continue our mission of rescuing, rehabilitating, and rehoming animals in need. Together, we can create a brighter future for these deserving creatures and make a lasting impact on their lives. Thank you for considering a donation to our organization and for being a part of our compassionate community.</p>
        </div>
    </section>
</Layout>