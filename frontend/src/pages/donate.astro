---
import Layout from "@/layouts/Layout.astro"
import ExternalLinkIcon from "@/components/Icons/ExternalLinkIcon.astro"
---

<Layout>
	<main class="bg-white">
		<!-- Hero Section -->
		<section class="relative bg-gradient-to-br from-[#e8f4f7] to-[#d1e9ee] py-12 sm:py-16 lg:py-20 px-4 sm:px-6 lg:px-8">
			<div class="max-w-7xl mx-auto text-center">
				<h1 class="text-3xl sm:text-4xl lg:text-5xl font-bold text-[#485a61] mb-6 lg:mb-8">Support Our Mission</h1>
				<p class="text-lg sm:text-xl lg:text-2xl text-[#485a61] opacity-80 max-w-4xl mx-auto leading-relaxed">
					Your donation helps provide veterinary care and support for companion animals of vulnerable people in our community.
				</p>
			</div>
		</section>

		<!-- Donation Options Section -->
		<section class="py-12 sm:py-16 px-4 sm:px-6 lg:px-8">
			<div class="max-w-6xl mx-auto">
				<div class="text-center mb-8 lg:mb-12">
					<h2 class="text-2xl sm:text-3xl lg:text-4xl font-bold text-[#485a61] mb-4 lg:mb-6">Choose Your Donation Platform</h2>
					<p class="text-lg lg:text-xl text-[#485a61] opacity-80 max-w-4xl mx-auto leading-relaxed">
						We accept donations through two secure platforms. Choose the one that works best for you.
					</p>
				</div>
				
				<div class="grid grid-cols-1 md:grid-cols-2 gap-6 lg:gap-8">
					<!-- Benevity Platform -->
					<div class="bg-white p-6 sm:p-8 rounded-lg shadow-lg border border-gray-200 hover:shadow-xl transition-shadow duration-300 flex flex-col h-full">
						<div class="w-14 h-14 sm:w-16 sm:h-16 lg:w-20 lg:h-20 bg-[#19b8d7] bg-opacity-10 rounded-lg flex items-center justify-center mb-4 sm:mb-6 mx-auto sm:mx-0">
							<svg class="w-7 h-7 sm:w-8 sm:h-8 lg:w-10 lg:h-10 text-[#19b8d7]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z" />
							</svg>
						</div>
						<h3 class="text-xl sm:text-2xl lg:text-3xl font-bold text-[#485a61] mb-3 sm:mb-4 text-center sm:text-left">ATB Cares</h3>
						<p class="text-base sm:text-lg text-[#485a61] opacity-80 leading-relaxed mb-4 sm:mb-6 flex-grow text-center sm:text-left">
							Donate through ATB Cares platform for secure, tax-deductible giving.
						</p>
						<a 
							href="https://atb.benevity.org/community/cause/124-840715577RR0001" 
							target="_blank" 
							rel="noopener noreferrer"
							class="inline-flex items-center justify-center w-full bg-[#19b8d7] text-white font-semibold py-3 px-4 sm:px-6 rounded-lg hover:bg-[#1699b3] transition-colors duration-200 text-center"
						>
							Donate on ATB Cares
							<ExternalLinkIcon />
						</a>
					</div>

					<!-- CanadaHelps Platform -->
					<div class="bg-white p-6 sm:p-8 rounded-lg shadow-lg border border-gray-200 hover:shadow-xl transition-shadow duration-300 flex flex-col h-full">
						<div class="w-14 h-14 sm:w-16 sm:h-16 lg:w-20 lg:h-20 bg-[#e25002] bg-opacity-10 rounded-lg flex items-center justify-center mb-4 sm:mb-6 mx-auto sm:mx-0">
							<svg class="w-7 h-7 sm:w-8 sm:h-8 lg:w-10 lg:h-10 text-[#e25002]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 9V7a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2m2 4h10a2 2 0 002-2v-6a2 2 0 00-2-2H9a2 2 0 00-2 2v6a2 2 0 002 2zm7-5a2 2 0 11-4 0 2 2 0 014 0z" />
							</svg>
						</div>
						<h3 class="text-xl sm:text-2xl lg:text-3xl font-bold text-[#485a61] mb-3 sm:mb-4 text-center sm:text-left">CanadaHelps</h3>
						<p class="text-base sm:text-lg text-[#485a61] opacity-80 leading-relaxed mb-4 sm:mb-6 flex-grow text-center sm:text-left">
							Support us through CanadaHelps, a trusted Canadian charity platform.
						</p>
						<a 
							href="https://www.canadahelps.org/en/dn/60255" 
							target="_blank" 
							rel="noopener noreferrer"
							class="inline-flex items-center justify-center w-full bg-[#e25002] text-white font-semibold py-3 px-4 sm:px-6 rounded-lg hover:bg-[#d94402] transition-colors duration-200 text-center"
						>
							Donate on CanadaHelps
							<ExternalLinkIcon />
						</a>
					</div>
				</div>
			</div>
		</section>
	</main>
</Layout>
