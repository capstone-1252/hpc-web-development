---
import Layout from "@/layouts/Layout.astro"
---

<Layout title="Contact Us - Alberta Helping Animals Society">
	<main class="bg-white">
		<!-- Hero Section -->
		<section class="relative bg-gradient-to-br from-[#e8f4f7] to-[#d1e9ee] py-12 sm:py-16 lg:py-20 px-4 sm:px-6 lg:px-8">
			<div class="max-w-7xl mx-auto text-center">
				<h1 class="text-3xl sm:text-4xl lg:text-5xl font-bold text-[#485a61] mb-6 lg:mb-8">Contact Us</h1>
				<p class="text-lg sm:text-xl lg:text-2xl text-[#485a61] opacity-80 max-w-4xl mx-auto leading-relaxed">
					Get in touch with Alberta Helping Animals Society for inquiries, donations, volunteer opportunities, or to learn more about our services.
				</p>
			</div>
		</section>

		<!-- Contact Information Section -->
		<section class="py-12 sm:py-16 px-4 sm:px-6 lg:px-8">
			<div class="max-w-6xl mx-auto">
				<div class="grid grid-cols-1 lg:grid-cols-2 gap-8 lg:gap-12">
					<div class="bg-white p-6 lg:p-8 rounded-lg shadow-lg border border-gray-200">
						<div class="w-12 h-12 lg:w-16 lg:h-16 bg-[#19b8d7] bg-opacity-10 rounded-lg flex items-center justify-center mb-4 lg:mb-6">
							<svg class="w-6 h-6 lg:w-8 lg:h-8 text-[#19b8d7]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
							</svg>
						</div>
						<h3 class="text-xl lg:text-2xl font-bold text-[#485a61] mb-4">Phone</h3>
						<p class="text-lg text-[#485a61] opacity-80 leading-relaxed">
							<span class="font-semibold">587-338-8668</span><br>
							Please leave a detailed message. It may take over a week to get back to you, so please be patient!
						</p>
					</div>
					<div class="bg-white p-6 lg:p-8 rounded-lg shadow-lg border border-gray-200">
						<div class="w-12 h-12 lg:w-16 lg:h-16 bg-[#e25002] bg-opacity-10 rounded-lg flex items-center justify-center mb-4 lg:mb-6">
							<svg class="w-6 h-6 lg:w-8 lg:h-8 text-[#e25002]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 4.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
							</svg>
						</div>
						<h3 class="text-xl lg:text-2xl font-bold text-[#485a61] mb-4">Email</h3>
						<p class="text-lg text-[#485a61] opacity-80 leading-relaxed">
							<span class="font-semibold">AlbertaHelpingAnimalsSociety@gmail.com</span><br>
							For volunteer opportunities, donations, and general inquiries
						</p>
					</div>
				</div>
			</div>
		</section>

		<!-- Contact Form Section -->
		<section class="py-12 sm:py-16 px-4 sm:px-6 lg:px-8 bg-gray-50">
			<div class="max-w-4xl mx-auto">
				<div class="text-center mb-8 lg:mb-12">
					<h2 class="text-2xl sm:text-3xl lg:text-4xl font-bold text-[#485a61] mb-4 lg:mb-6">Send Us a Message</h2>
					<p class="text-lg lg:text-xl text-[#485a61] opacity-80 max-w-3xl mx-auto leading-relaxed">
						Fill out the form below and we'll get back to you as soon as possible.
					</p>
				</div>
				
				<form class="bg-white p-6 lg:p-8 rounded-lg shadow-lg border border-gray-200" action="">
					<div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-6">
						<div>
							<label for="name" class="block text-sm font-medium text-[#485a61] mb-2">Full Name *</label>
							<input 
								type="text" 
								id="name" 
								name="name" 
								required
								class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-[#19b8d7] focus:border-[#19b8d7] outline-none transition-colors"
								placeholder="John Doe"
							>
						</div>
						<div>
							<label for="email" class="block text-sm font-medium text-[#485a61] mb-2">Email Address *</label>
							<input 
								type="email" 
								id="email" 
								name="email" 
								required
								class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-[#19b8d7] focus:border-[#19b8d7] outline-none transition-colors"
								placeholder="john@example.com"
							>
						</div>
					</div>
					
					<div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-6">
						<div>
							<label for="phone" class="block text-sm font-medium text-[#485a61] mb-2">Phone Number</label>
							<input 
								type="tel" 
								id="phone" 
								name="phone"
								class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-[#19b8d7] focus:border-[#19b8d7] outline-none transition-colors"
								placeholder="(587) 123-4567"
							>
						</div>
						<div>
							<label for="subject" class="block text-sm font-medium text-[#485a61] mb-2">Subject *</label>
							<select 
								id="subject" 
								name="subject" 
								required
								class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-[#19b8d7] focus:border-[#19b8d7] outline-none transition-colors"
							>
								<option value="">Select a topic</option>
								<option value="general">General Inquiry</option>
								<option value="volunteer">Volunteer Opportunities</option>
								<option value="donation">Donations</option>
								<option value="services">Veterinary Services</option>
								<option value="partnership">Partnership Opportunities</option>
								<option value="other">Other</option>
							</select>
						</div>
					</div>
					
					<div class="mb-6">
						<label for="message" class="block text-sm font-medium text-[#485a61] mb-2">Message *</label>
						<textarea 
							id="message" 
							name="message" 
							rows="6" 
							required
							class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-[#19b8d7] focus:border-[#19b8d7] outline-none transition-colors resize-none"
							placeholder="Please tell us how we can help you..."
						></textarea>
					</div>
					
					<div class="text-center">
						<button 
							type="submit" 
							class="bg-[#e25002] hover:bg-[#c44301] text-white px-8 lg:px-10 py-3 lg:py-4 rounded-lg text-base lg:text-lg font-semibold transition-colors shadow-lg hover:shadow-xl transform hover:scale-105 whitespace-nowrap"
						>
							Send Message
						</button>
					</div>
				</form>
			</div>
		</section>

		<!-- Clinic Location Section -->
		<section class="py-12 sm:py-16 px-4 sm:px-6 lg:px-8">
			<div class="max-w-6xl mx-auto">
				<div class="bg-white p-6 lg:p-8 rounded-lg shadow-lg border border-gray-200">
					<div class="w-12 h-12 lg:w-16 lg:h-16 bg-[#fdb52b] bg-opacity-20 rounded-lg flex items-center justify-center mb-4 lg:mb-6">
						<svg class="w-6 h-6 lg:w-8 lg:h-8 text-[#fdb52b]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
						</svg>
					</div>
					<h3 class="text-xl lg:text-2xl font-bold text-[#485a61] mb-4">Clinic Location</h3>
					<p class="text-lg text-[#485a61] opacity-80 leading-relaxed mb-4">
						<span class="font-semibold">Address:</span> 12701 – 119 Street NW, Edmonton, AB<br>
						<span class="font-semibold">Hours:</span> Monday - Friday, 10:00 AM - 4:00 PM<br>
						<span class="font-semibold">After Hours:</span> Pet Food Bank available in our parking lot
					</p>
					<div class="bg-gray-100 rounded-lg p-4 lg:p-6 text-center">
						<p class="text-[#485a61] mb-4">Map placeholder - Interactive map would be implemented here</p>
						<div class="bg-[#e8f4f7] rounded-lg h-48 lg:h-64 flex items-center justify-center">
							<svg class="w-16 h-16 lg:w-24 lg:h-24 text-[#19b8d7]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 20l-5.447-2.724A1 1 0 013 16.382V5.618a1 1 0 011.447-.894L9 7m0 13l6-3m-6 3V7m6 10l4.553 2.276A1 1 0 0021 18.382V7.618a1 1 0 00-.553-.894L15 4m0 13V4m0 0L9 7" />
							</svg>
						</div>
					</div>
				</div>
			</div>
		</section>

		<!-- Emergency Information Section -->
		<section class="py-12 sm:py-16 px-4 sm:px-6 lg:px-8 bg-gradient-to-br from-[#19b8d7] to-[#485a61]">
			<div class="max-w-6xl mx-auto">
				<div class="text-center text-white">
					<h2 class="text-2xl sm:text-3xl lg:text-4xl font-bold mb-4 lg:mb-6">Emergency Information</h2>
					<p class="text-lg lg:text-xl opacity-90 mb-6 lg:mb-8 leading-relaxed max-w-4xl mx-auto">
						If you are experiencing a pet emergency, please contact an emergency veterinary clinic immediately. 
						AHAS is not able to offer urgent services to new clients except under extraordinary circumstances.
					</p>
					<div class="bg-white bg-opacity-20 backdrop-blur-sm rounded-lg p-6 lg:p-8">
						<p class="text-xl font-semibold mb-4">For Pet Emergencies:</p>
						<p class="text-lg mb-2">Contact your nearest emergency veterinary clinic</p>
						<p class="text-lg">Search online for "emergency vet near me" for immediate assistance</p>
					</div>
				</div>
			</div>
		</section>
	</main>
</Layout>
