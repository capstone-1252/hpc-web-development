---
import Layout from "@/layouts/Layout.astro"
// import { loadWeeklyHours } from "@/components/loaders/loadHours"
// const hours = await loadWeeklyHours();
---

<Layout title="Contact Us - Alberta Helping Animals Society">
	<main class="bg-white">
		<!-- Hero Section -->
		<section class="relative bg-[#D1E9EE] py-12 sm:py-16 lg:py-20 overflow-hidden">
			<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative">
				<h1 class=" text-[#485a61] text-4xl sm:text-5xl lg:text-6xl font-bold leading-tight mb-6">Contact Us</h1>
				<p class="text-lg sm:text-xl lg:text-2xl text-[#485a61]  max-w-3xl leading-relaxed">
					Have a question, want to get involved? or need help? We'd love to hear from you.
				</p>
			</div>
		</section>

		<!-- Contact Information Section -->
		<section class="py-12 sm:py-16 px-4 sm:px-6 lg:px-8">
			<div class="max-w-4xl mx-auto">
				<h2 class="text-3xl font-semibold text-gray-800 mb-6">Get in Touch</h2>
				<!-- Container -->
				<div class="flex flex-col lg:flex-row lg:items-start lg:gap-0 relative">

					<div class="bg-[#15A1BD] opacity-80 p-6 lg:p-8 rounded-md shadow-lg border border-gray-200 lg:w-[60%]">
						<h3 class="text-xl lg:text-2xl font-bold text-white mb-4">Have something to donate?</h3>
						<p class="text-lg text-white leading-relaxed">
							Please contact us by email: AlbertaHelpingAnimalsSociety@gmail.com</p>
					</div>

					<div class="bg-[#D1E9EE] p-6 lg:p-8 rounded-md shadow-lg border border-gray-200 lg:w-[60%] lg:-ml-24 lg:mt-32 ">
						<h3 class="text-xl lg:text-2xl font-bold text-[#485a61] mb-4 text-right">Phone</h3>
						<p class="text-lg text-[#485a61] opacity-80 leading-relaxed text-right">
							<span class="font-semibold">587-338-8668</span><br>
							Please leave a detailed message. It can take over a week to get back to you so please be patient!
						</p>
					</div>
				</div>
			</div>
		</section>

		<!-- TODO: Need to update this section to use cms hours -->
		<section>
			<div class="flex flex-col lg:flex-row items-center justify-center 
			gap-12 max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
				<div class="bg-[#15A1BD] opacity-80 p-6 lg:p-8 rounded-md shadow-lg border border-gray-200 lg:w-[50%]">
				<h3 class="text-4xl text-white mb-4">Hours for Operation</h3>
				<ul class="text-white space-y-1">
					<li>Monday: 10 a.m. - 4 p.m.</li>
					<li>Tuesday: 10 a.m. - 4 p.m.</li>
					<li>Wednesday: 10 a.m. - 4 p.m.</li>
					<li>Thursday: 10 a.m. - 4 p.m.</li>
					<li>Friday: 10 a.m. - 4 p.m.</li>
					<li>Saturday: 10 a.m. - 4 p.m.</li>
					<li>Sunday: Closed</li>
				</ul>
				</div>
				<div class="lg:w-[25%] m:w-[40%] sm:w-[40%] flex justify-center">
				<img
					src="/hero/connie-cat1.avif"
					alt="Picture of Connie with a Cat"
					class="w-full max-w-md h-auto object-cover rounded-md shadow-lg"
				/>
				</div>
			</div>
		</section>
	</main>
</Layout>
