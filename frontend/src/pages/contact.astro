---
import Layout from "@/layouts/Layout.astro"
// import { loadWeeklyHours } from "@/components/loaders/loadHours"
// const hours = await loadWeeklyHours();
import { Image } from "astro:assets"
import resourcesHeroImage from "@/assets/contactus-hero.avif"
---

<Layout title="Contact Us - Alberta Helping Animals Society">
	<main class="bg-white">
		<!-- HERO -->
      <section class="bg-[#D1E9EE] py-2 sm:py-2 lg:py-5 px-4 sm:px-2 lg:px-4 overflow-x-hidden">
         <div class="max-w-2xl lg:max-w-7xl mx-auto">
            <div class="flex flex-col lg:flex-row items-center gap-8">
               <!-- Content -->
               <div class="w-full lg:w-1/2">
                  <h1 class="text-2xl sm:text-3xl lg:text-4xl font-bold text-(--dark-blue) mb-4 lg:mb-6 leading-tight break-words">
                     Animal Care Resources
                  </h1>
                  <h2 class="text-2xl sm:text-3xl lg:text-4xl font-bold text-(--hero-blue) mb-4 lg:mb-6 leading-tight break-words">Contact Us</h2>
                  <p class="text-lg sm:text-xl text-[var(--muted-foreground)] mb-6 lg:mb-8 leading-relaxed max-w-2xl lg:mx-0">
                     Have a question, want to get involved? or need help? We'd love to hear from you. Please reach out to us through any of the contact methods below and we will get back to you as soon as possible.
                  </p>
               </div>
               <!-- Image -->
               <div class="w-full lg:w-1/2 flex justify-center lg:justify-end">
                  <Image 
                     src={resourcesHeroImage} 
                     alt="Hero Banner for Resources Page"
                     class="w-[420px] sm:w-[400px] md:w-[350px] lg:w-[500px] max-w-none"
                     />
               </div>
            </div>
         </div>
      </section>

		<!-- Contact Information Section -->
		<section class="py-12 sm:py-16 px-4 sm:px-6 lg:px-8">
			<div class="lg:max-w-4xl sm:max-w-xl md:max-w-xl mx-auto">
				<h2 class="text-3xl font-semibold text-gray-800 mb-6">Get in Touch</h2>
				<!-- Container -->
				<div class="flex flex-col lg:flex-row lg:items-start lg:gap-0 relative">

					<div class="bg-[#0C5E6E] opacity-80 p-6 lg:p-8 rounded-md shadow-lg border border-gray-200 lg:w-[60%]">
						<h3 class="text-xl lg:text-2xl font-bold text-white mb-4">Have something to donate?</h3>
						<p class="text-lg text-white leading-relaxed">
							Please contact us by email: AlbertaHelpingAnimalsSociety@gmail.com</p>
					</div>

					<div class="bg-[#D1E9EE] p-6 lg:p-8 rounded-md shadow-lg border border-gray-200 lg:w-[60%] lg:-ml-24 lg:mt-32 ">
						<h3 class="text-xl lg:text-2xl font-bold text-[#485a61] mb-4 text-right">Phone</h3>
						<p class="text-lg text-black opacity-80 leading-relaxed text-right">
							<span class="font-semibold">587-338-8668</span><br>
							Please leave a detailed message. It can take over a week to get back to you so please be patient!
						</p>
					</div>
				</div>
			</div>
		</section>

		<!-- TODO: Need to update this section to use cms hours -->
		<section>
			<div class="flex flex-col lg:flex-row items-center justify-center 
			gap-12 max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
				<div class="bg-[#0C5E6E] opacity-80 p-6 lg:p-8 rounded-md shadow-lg border border-gray-200 lg:w-[50%]">
				<h3 class="text-4xl text-white mb-4 font-bold">Hours for Operation</h3>
				<ul class="text-white space-y-1">
					<li>Monday: 10 a.m. - 4 p.m.</li>
					<li>Tuesday: 10 a.m. - 4 p.m.</li>
					<li>Wednesday: 10 a.m. - 4 p.m.</li>
					<li>Thursday: 10 a.m. - 4 p.m.</li>
					<li>Friday: 10 a.m. - 4 p.m.</li>
					<li>Saturday: 10 a.m. - 4 p.m.</li>
					<li>Sunday: Closed</li>
				</ul>
				</div>
				<div class="lg:w-[25%] m:w-[40%] sm:w-[40%] flex justify-center">
				<img
					src="/hero/connie-cat1.avif"
					alt="Picture of Connie with a Cat"
					class="w-full max-w-md h-auto object-cover rounded-md shadow-lg"
				/>
				</div>
			</div>
		</section>
	</main>
</Layout>
