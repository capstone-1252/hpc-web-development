---
import Layout from "@/layouts/Layout.astro"
---

<Layout title="About Us - Alberta Helping Animals Society">
	<main class="bg-white">
		<!-- Hero Section -->
		<section class="bg-(--muted-blue) py-16 sm:py-20 lg:py-24 px-6 sm:px-8 lg:px-10">
			<div class="max-w-7xl mx-auto">
				<div class="flex flex-col lg:flex-row gap-10 lg:gap-16 items-center">
					<div class="flex-1 lg:text-left">
						<h1 class="text-4xl sm:text-5xl lg:text-6xl font-bold text-dark-blue mb-6 leading-tight" style="font-family: 'Ubuntu', sans-serif;">
							About Alberta Helping Animals Society
						</h1>
						<p class="text-lg sm:text-xl text-foreground leading-relaxed max-w-2xl mx-auto lg:mx-0">
							Dedicated to creating opportunities for vulnerable people to access veterinary care and other services for their companion animals.
						</p>
					</div>
					<div class="flex-shrink-0">
						<!-- Image placeholder with veterinary imagery -->
						<div class="w-[300px] h-[300px] sm:w-[350px] sm:h-[350px] lg:w-[400px] lg:h-[400px] bg-gradient-to-br from-slate-200 to-slate-300 rounded-xl overflow-hidden relative shadow-lg">
							<div class="absolute inset-0 flex items-center justify-center">
								<div class="text-slate-400 text-center">
									<svg class="w-20 h-20 mx-auto mb-3 opacity-50" fill="none" stroke="currentColor" viewBox="0 0 24 24">
										<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"/>
									</svg>
									<p class="text-sm font-medium">Coming Soon</p>
								</div>
							</div>
						</div>
					</div>
				</div>
			</div>
		</section>

		<!-- Our Mission & What We Do Section -->
		<section class="py-16 sm:py-20 lg:py-24 px-6 sm:px-8 lg:px-10">
			<div class="max-w-6xl mx-auto">
				<div class="grid grid-cols-1 lg:grid-cols-2 gap-8 lg:gap-10">
					<!-- Our Mission Card -->
					<div class="bg-white rounded-2xl shadow-md p-8 border border-border/50">
						<span class="inline-block text-sm font-semibold text-primary uppercase tracking-wide mb-3">Our Mission</span>
						<h2 class="text-2xl sm:text-3xl lg:text-4xl font-normal text-dark-blue mb-6" style="font-family: 'Ubuntu', sans-serif;">
							Our Mission
						</h2>
						<p class="text-lg text-foreground leading-relaxed">
							Our mission is to create opportunities for vulnerable individuals to access veterinary care and essential services for their companion animals.
						</p>
					</div>
					<!-- What We Do Card -->
					<div class="bg-white rounded-2xl shadow-md p-8 border border-border/50">
						<span class="inline-block text-sm font-semibold text-primary uppercase tracking-wide mb-3">What We Do</span>
						<h2 class="text-2xl sm:text-3xl lg:text-4xl font-normal text-dark-blue mb-6" style="font-family: 'Ubuntu', sans-serif;">
							What We Do
						</h2>
						<p class="text-lg text-foreground leading-relaxed">
							The Alberta Helping Animals Society (AHAS) is a registered non-profit organization providing accessible veterinary care for companion animals in Edmonton, Alberta. Our work focuses on supporting vulnerable individuals who rely on their pets for companionship, emotional support, and stability.
						</p>
					</div>
				</div>
			</div>
		</section>

		<!-- Our Vision Section -->
		<section class="py-16 sm:py-20 lg:py-24 px-6 sm:px-8 lg:px-10 bg-muted-blue/30">
			<div class="max-w-6xl mx-auto">
				<div class="flex flex-col lg:flex-row gap-10 lg:gap-16 items-center">
					<div class="flex-1 order-1 lg:order-2">
						<span class="inline-block text-sm font-semibold text-primary uppercase tracking-wide mb-3">Our Vision</span>
						<h2 class="text-2xl sm:text-3xl lg:text-4xl font-normal text-dark-blue mb-6" style="font-family: 'Ubuntu', sans-serif;">
							Our Vision
						</h2>
						<p class="text-lg text-foreground leading-relaxed">
							Our vision is a community where all companion animals of vulnerable people have access to veterinary care, supporting both animal health and the well-being of the people who love them.
						</p>
					</div>
				</div>
			</div>
		</section>

		<!-- Why We Exist Section -->
		<section class="py-16 sm:py-20 lg:py-24 px-6 sm:px-8 lg:px-10 bg-slate-900 text-white">
			<div class="max-w-6xl mx-auto">
				<div class="flex flex-col lg:flex-row gap-10 lg:gap-16 items-center">
					<div class="flex-1">
						<span class="inline-block text-sm font-semibold text-primary uppercase tracking-wide mb-3">Our Story</span>
						<h2 class="text-2xl sm:text-3xl lg:text-4xl font-normal mb-6 text-white" style="font-family: 'Ubuntu', sans-serif;">
							Why We Exist
						</h2>
						<div class="bg-white/10 backdrop-blur-sm p-8 rounded-xl border border-white/10">
							<p class="text-lg leading-relaxed text-white/90">
								The Alberta Helping Animals Society (AHAS) is a registered non-profit organization providing accessible veterinary care for companion animals in Edmonton, Alberta. Our work focuses on supporting vulnerable individuals who rely on their pets for companionship, emotional support, and stability.
							</p>
						</div>
					</div>
					<div class="flex-shrink max-w-md">
						<img 
							src="/why-we-exist-750.jpg" 
							alt="" 
							class="rounded-lg"
						>
					</div>
				</div>
			</div>
		</section>

		<!-- Who and How We Serve Section -->
		<section class="py-8 sm:py-10 lg:py-12 px-6 sm:px-8 lg:px-10">
			<div class="max-w-5xl mx-auto">
				<span class="inline-block text-sm font-semibold text-primary uppercase tracking-wide mb-3">Our Community</span>
				<h2 class="text-2xl sm:text-3xl lg:text-4xl font-normal text-dark-blue mb-6" style="font-family: 'Ubuntu', sans-serif;">
					Who & How We Serve
				</h2>
				<p class="text-lg text-foreground leading-relaxed mx-auto mb-10">
					Alberta Helping Animals Society serves both animals and their humans. Vulnerable individuals are particularly bonded to and rely on their companion animals for social support, companionship, and unconditional love. Ensuring the health and well-being of these animals is vital to ensuring the health and well-being of the owners, and further strengthens this very special human-animal bond.
				</p>
			</div>
		</section>

		<section class="py-8 sm:py-10 lg:py-12 px-6 sm:px-8 lg:px-10 bg-muted-blue/20">
			<div class="max-w-5xl mx-auto">
				<div class="grid grid-cols-1 md:grid-cols-2 gap-8 lg:gap-10">
					<div class="bg-white rounded-2xl shadow-md p-8 border border-border/50">
						<div class="flex items-center gap-3 mb-4">
							<div class="w-12 h-12 bg-primary/10 rounded-xl flex items-center justify-center">
								<svg class="w-6 h-6 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"/>
								</svg>
							</div>
							<h2 class="text-xl sm:text-2xl font-normal text-dark-blue" style="font-family: 'Ubuntu', sans-serif;">
								Community Support
							</h2>
						</div>
						<p class="text-base text-foreground leading-relaxed mb-6">
							Our services extend beyond veterinary care. We proudly support the Boyle Street Community Services Pet Food Bank with weekly donations of dog food, cat food, litter, and other pet supplies and provide food and supplies when we can from our own clinic.
						</p>
					</div>
					<!-- Veterinary Services Card -->
					<div class="bg-white rounded-2xl shadow-md p-8 border border-border/50">
						<div class="flex items-center gap-3 mb-4">
							<div class="w-12 h-12 bg-primary/10 rounded-xl flex items-center justify-center">
								<svg class="w-6 h-6 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z"/>
								</svg>
							</div>
							<h2 class="text-xl sm:text-2xl font-normal text-dark-blue" style="font-family: 'Ubuntu', sans-serif;">
								Veterinary Services
							</h2>
						</div>
						<p class="text-base text-foreground leading-relaxed">
							AHAS Home Veterinary Services provides no-cost veterinary and other services in Edmonton to vulnerable people who are unable to access regular veterinary care. We provide wellness exams, spay and neuter surgery, diagnosis and care for chronic illness, dentistry, palliative care, and end-of-life support.
						</p>
					</div>
				</div>
			</div>
		</section>

		<!-- Our Volunteers Section -->
		<section class="py-16 sm:py-20 lg:py-24 px-6 sm:px-8 lg:px-10 bg-muted-blue/30">
			<div class="max-w-5xl mx-auto">
				<div class="mb-12">
					<span class="inline-block text-sm font-semibold text-primary uppercase tracking-wide mb-3">Our Team</span>
					<h2 class="text-2xl sm:text-3xl lg:text-4xl font-normal text-dark-blue" style="font-family: 'Ubuntu', sans-serif;">
						Our Volunteers
					</h2>
				</div>
				<div class="grid grid-cols-1 md:grid-cols-3 gap-6 lg:gap-8">
					<!-- Volunteer Card 1 -->
					<div class="bg-white rounded-2xl shadow-sm p-8 border border-border/50 hover:shadow-md transition-shadow">
						<div class="w-[88px] h-[88px] bg-gradient-to-br from-slate-100 to-slate-200 rounded-full mx-auto mb-5 overflow-hidden flex items-center justify-center">
							<svg class="w-12 h-12 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
							</svg>
						</div>
						<h3 class="text-lg font-normal text-dark-blue mb-2" style="font-family: 'Ubuntu', sans-serif;">
							Coming Soon
						</h3>
						<p class="text-base text-primary font-medium">
							Volunteer
						</p>
					</div>
					<!-- Volunteer Card 2 -->
					<div class="bg-white rounded-2xl shadow-sm p-8 border border-border/50 hover:shadow-md transition-shadow">
						<div class="w-[88px] h-[88px] bg-gradient-to-br from-slate-100 to-slate-200 rounded-full mx-auto mb-5 overflow-hidden flex items-center justify-center">
							<svg class="w-12 h-12 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
							</svg>
						</div>
						<h3 class="text-lg font-normal text-dark-blue mb-2" style="font-family: 'Ubuntu', sans-serif;">
							Coming Soon
						</h3>
						<p class="text-base text-primary font-medium">
							Volunteer
						</p>
					</div>
					<!-- Volunteer Card 3 -->
					<div class="bg-white rounded-2xl shadow-sm p-8 border border-border/50 hover:shadow-md transition-shadow">
						<div class="w-[88px] h-[88px] bg-gradient-to-br from-slate-100 to-slate-200 rounded-full mx-auto mb-5 overflow-hidden flex items-center justify-center">
							<svg class="w-12 h-12 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
							</svg>
						</div>
						<h3 class="text-lg font-normal text-dark-blue mb-2" style="font-family: 'Ubuntu', sans-serif;">
							Coming Soon
						</h3>
						<p class="text-base text-primary font-medium">
							Volunteer
						</p>
					</div>
				</div>
			</div>
		</section>

		<!-- Our Board of Directors Section -->
		<section class="py-16 sm:py-20 lg:py-24 px-6 sm:px-8 lg:px-10">
			<div class="max-w-5xl mx-auto">
				<div class="mb-6">
					<span class="inline-block text-sm font-semibold text-primary uppercase tracking-wide mb-3">Leadership</span>
					<h2 class="text-2xl sm:text-3xl lg:text-4xl font-normal text-dark-blue mb-6" style="font-family: 'Ubuntu', sans-serif;">
						Our Board of Directors
					</h2>
				</div>
				<p class="text-lg text-foreground leading-relaxed mx-auto mb-12 ">
					The Alberta Helping Animals Society (AHAS) Board of Directors consists of non-remunerated volunteers. The Board is responsible for the management of affairs and policies, and provides an overall strategic direction for AHAS to ensure its continuing success.
				</p>
				<div class="grid grid-cols-1 md:grid-cols-3 gap-6 lg:gap-8">
					<!-- Board Member Card 1 -->
					<div class="bg-muted-blue/40 rounded-2xl shadow-sm p-8 border border-border/50 hover:shadow-md transition-shadow">
						<div class="w-[88px] h-[88px] bg-gradient-to-br from-slate-100 to-slate-200 rounded-full mx-auto mb-5 overflow-hidden flex items-center justify-center">
							<svg class="w-12 h-12 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
							</svg>
						</div>
						<h3 class="text-lg font-normal text-dark-blue mb-2" style="font-family: 'Ubuntu', sans-serif;">
							Coming Soon
						</h3>
						<p class="text-base text-primary font-medium">
							Board Member
						</p>
					</div>
					<!-- Board Member Card 2 -->
					<div class="bg-muted-blue/40 rounded-2xl shadow-sm p-8 border border-border/50 hover:shadow-md transition-shadow">
						<div class="w-[88px] h-[88px] bg-gradient-to-br from-slate-100 to-slate-200 rounded-full mx-auto mb-5 overflow-hidden flex items-center justify-center">
							<svg class="w-12 h-12 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
							</svg>
						</div>
						<h3 class="text-lg font-normal text-dark-blue mb-2" style="font-family: 'Ubuntu', sans-serif;">
							Coming Soon
						</h3>
						<p class="text-base text-primary font-medium">
							Board Member
						</p>
					</div>
					<!-- Board Member Card 3 -->
					<div class="bg-muted-blue/40 rounded-2xl shadow-sm p-8 border border-border/50 hover:shadow-md transition-shadow">
						<div class="w-[88px] h-[88px] bg-gradient-to-br from-slate-100 to-slate-200 rounded-full mx-auto mb-5 overflow-hidden flex items-center justify-center">
							<svg class="w-12 h-12 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
							</svg>
						</div>
						<h3 class="text-lg font-normal text-dark-blue mb-2" style="font-family: 'Ubuntu', sans-serif;">
							Coming Soon
						</h3>
						<p class="text-base text-primary font-medium">
							Board Member
						</p>
					</div>
				</div>
			</div>
		</section>

		<!-- Call to Action -->
		<section class="py-16 sm:py-20 lg:py-24 px-6 sm:px-8 lg:px-10 bg-gradient-to-br from-primary/10 to-primary/5">
			<div class="max-w-4xl mx-auto ">
				<h2 class="text-2xl sm:text-3xl lg:text-4xl font-bold text-dark-blue mb-6">
					Join Us in Making a Difference
				</h2>
				<p class="text-lg text-foreground leading-relaxed mb-10 mx-auto">
					Whether you choose to donate, volunteer, or simply spread the word, every action helps us provide critical care to the animals and families who need it most.
				</p>
				<div class="flex flex-col sm:flex-row gap-4 justify-center">
					<a href="/donate" class="bg-destructive hover:bg-destructive/90 text-white px-10 py-4 rounded-xl text-lg font-semibold transition-all shadow-lg hover:shadow-xl">
						Donate Now
					</a>
					<a href="/get-involved" class="bg-white hover:bg-gray-50 text-dark-blue border-2 border-dark-blue px-10 py-4 rounded-xl text-lg font-semibold transition-all hover:bg-dark-blue hover:text-white">
						Get Involved
					</a>
				</div>
			</div>
		</section>
	</main>
</Layout>
